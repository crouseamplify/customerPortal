            </value>
        </filters>
        <filters>
            <field>Opp_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Sample Order Form</stringValue>
            </value>
        </filters>
        <filters>
            <field>Sync_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Error - Product ID</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Primary_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Input_Contact_Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primary_Contact__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Hide_BSO_From_Customer__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Hidden</stringValue>
            </value>
        </filters>
        <filters>
            <field>RMA_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>RMA in Progress</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Fully Shipped</stringValue>
            </value>
        </filters>
        <filters>
            <field>Sync_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Error - Account Name</stringValue>
            </value>
        </filters>
        <filters>
            <field>Sync_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Error - Account &amp; Product</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Blanket_Sales_Orders__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
