        <filterLogic>(1 OR (6 AND 7)) AND 2 AND 3 AND 4 AND 5 AND 7 AND 8 AND 9 AND 10 AND 11 AND 12 AND 13</filterLogic>
        <filters>
            <field>Account_Name__c</field>
            <operator>EqualTo</operator>
