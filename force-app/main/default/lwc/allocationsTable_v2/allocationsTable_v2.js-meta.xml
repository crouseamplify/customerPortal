<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Allocation Table Component v2</masterLabel>
    <description>The allocation table component for amplify CALM. Updated for OMP 2.0.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="orderAllocations" type="@salesforce/schema/Order_Allocation__c[]" label="Order Allocations"></property>
            <property name="orderAllocationProducts" type="@salesforce/schema/Order_Allocation_Product__c[]" label="Order Allocation Products"></property>
            <property name="bsoProducts" type="@salesforce/schema/Blanket_Sales_Order_Product__c[]" label="Blanket Sales Order Products"></property>
            <property name="orderAllocationProductsOutput" type="@salesforce/schema/Order_Allocation_Product__c[]" label="Order Allocation Products Output" role="outputOnly"></property>
            <property name="bsoProductsOutput" type="@salesforce/schema/Blanket_Sales_Order_Product__c[]" label="Blanket Sales Order Products Output" role="outputOnly"></property>
            <property name="blanketSaleOrder" type="@salesforce/schema/Blanket_Sales_Orders__c" label="Blanket Sales Order"></property>
            <property name="orderAllocationRequest" type="@salesforce/schema/Order_Allocation_Request__c" label="Order Allocation Request"></property>
            <property name="usePagination" type="Boolean" label="Use Pagination" default="true"></property>
            <property name="hideNewAllocationButton" type="Boolean" label="Hide New Allocation Button" default="false"></property>
            <property name="deletedAllocations" type="@salesforce/schema/Order_Allocation__c[]" label="Deleted Allocations" role="outputOnly"></property>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>