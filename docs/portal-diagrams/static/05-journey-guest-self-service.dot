digraph G {
  graph [fontname="Helvetica", rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  label=<<B>Journey 2: Self-service without logging in</B>>; labelloc=t; labeljust=l; fontsize=15; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];
ranksep=0.55;

    g0 [label=<Guest or any user<BR/><FONT POINT-SIZE="8" COLOR="#555555">no login needed for these pages</FONT>>, shape="box", style="rounded,filled", fillcolor="#FFFDE7", color="#F57F17", class="n-person", id="g0"];
    p1 [label=<<FONT POINT-SIZE="8" COLOR="#555555">PAGE</FONT><BR/>Submit a PO<BR/><FONT POINT-SIZE="8" COLOR="#555555">/submit-a-po</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="p1"];
    f1 [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>PO Submission<BR/><FONT POINT-SIZE="8" COLOR="#555555">email, PO number, quote numbers,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">optional tax-exemption file</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="f1"];
    d1 [label=<Community Portal Log<BR/><FONT POINT-SIZE="8" COLOR="#555555">+ Contact, Task, file links</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="d1"];
    b1 [label=<<FONT POINT-SIZE="8" COLOR="#555555">BACK-OFFICE</FONT><BR/>Portal Log -&gt; Cases +<BR/>confirmation<BR/><FONT POINT-SIZE="8" COLOR="#555555">creates Cases per quote, links</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">documents</FONT>>, shape="box", style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#9E9E9E", class="n-auto", id="b1"];
    p2 [label=<<FONT POINT-SIZE="8" COLOR="#555555">PAGE</FONT><BR/>Make a Payment<BR/><FONT POINT-SIZE="8" COLOR="#555555">/make-a-payment</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">static remittance instructions</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="p2"];
    p3 [label=<<FONT POINT-SIZE="8" COLOR="#555555">PAGE</FONT><BR/>Support<BR/><FONT POINT-SIZE="8" COLOR="#555555">/support (Webform layout)</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="p3"];
    f3 [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Web Form to Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">too-fast submit = bot trap</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="f3"];
    f3b [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>Create Case from Webform<BR/><FONT POINT-SIZE="8" COLOR="#555555">queue routing, email, attachments</FONT>>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", id="f3b", peripheries="2"];
    d3 [label=<Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">+ Case Web Form Comment event</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="d3"];
    p4 [label=<<FONT POINT-SIZE="8" COLOR="#555555">PAGE</FONT><BR/>Help Center -&gt; Knowledge<BR/>article<BR/><FONT POINT-SIZE="8" COLOR="#555555">/help, /article</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="p4"];
    f4 [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Article Feedback<BR/><FONT POINT-SIZE="8" COLOR="#555555">thumbs up/down + reason</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="f4"];
    d4 [label=<Article Feedback>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="d4"];
    p5 [label=<<FONT POINT-SIZE="8" COLOR="#555555">PAGE</FONT><BR/>Shipment Status<BR/><FONT POINT-SIZE="8" COLOR="#555555">/shipment-status?token=…</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">link sent by email</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="p5"];
    f5 [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Material Status v2<BR/><FONT POINT-SIZE="8" COLOR="#555555">token -&gt; PQ -&gt; Opportunity</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">+ Integration Data Sync</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="f5"];
    d5 [label=<Community Portal Log<BR/><FONT POINT-SIZE="8" COLOR="#555555">request log</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="d5"];
    p6 [label=<<FONT POINT-SIZE="8" COLOR="#555555">PAGE</FONT><BR/>School Scheduling<BR/><FONT POINT-SIZE="8" COLOR="#555555">/school-scheduling?token=…</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="p6"];
    f6 [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Tutor School Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">school info or approval</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="f6"];
    d6 [label=<Tutor School Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">-&gt; Tutor automation (record-</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">triggered)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="d6"];
  g0 -> p1;
  p1 -> f1;
  f1 -> d1;
  d1 -> b1 [style="dashed"];
  g0 -> p2;
  g0 -> p3;
  p3 -> f3;
  f3 -> f3b;
  f3b -> d3;
  g0 -> p4;
  p4 -> f4;
  f4 -> d4;
  g0 -> p5;
  p5 -> f5;
  f5 -> d5;
  g0 -> p6;
  p6 -> f6;
  f6 -> d6;
}