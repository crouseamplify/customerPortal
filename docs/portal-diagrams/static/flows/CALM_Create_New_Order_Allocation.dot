digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Create_New_Order_Allocation_start"];
  CALM_Create_New_Order_Allocation_Allocation_Already_Submitted_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Allocation Already Submitted<BR/>Screen>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Create_New_Order_Allocation_Allocation_Already_Submitted_Screen", penwidth="2.6"];
  CALM_Create_New_Order_Allocation_Create_New_Order_Allocation [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Create New Order Allocation<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker, textAreaPlus</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Create_New_Order_Allocation_Create_New_Order_Allocation", penwidth="1.2"];
  CALM_Create_New_Order_Allocation_Check_if_Order_Allocation_Request_has_been_Submitted [label=<Check if Order<BR/>Allocation Request<BR/>has been Submitted>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Create_New_Order_Allocation_Check_if_Order_Allocation_Request_has_been_Submitted", penwidth="1.2"];
  CALM_Create_New_Order_Allocation_Loop_Blanket_Sales_Order_Products [label=<<FONT POINT-SIZE="8" COLOR="#555555">LOOP</FONT><BR/>Loop Blanket Sales Order<BR/>Products>, shape="box", style="rounded,filled,dashed", fillcolor="#E8EAF6", color="#3949AB", class="n-loop", id="CALM_Create_New_Order_Allocation_Loop_Blanket_Sales_Order_Products", penwidth="1.2"];
  CALM_Create_New_Order_Allocation_Get_Blanket_Sales_Order [label=<Get Blanket Sales Order<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Blanket Sales Order (BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Create_New_Order_Allocation_Get_Blanket_Sales_Order", penwidth="1.2"];
  CALM_Create_New_Order_Allocation_Get_Newly_Created_Order_Allocation [label=<Get Newly Created Order<BR/>Allocation<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation (site)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Create_New_Order_Allocation_Get_Newly_Created_Order_Allocation", penwidth="1.2"];
  CALM_Create_New_Order_Allocation_Get_Related_Blanket_Sales_Order_Products [label=<Get Related Blanket Sales<BR/>Order Products<BR/><FONT POINT-SIZE="8" COLOR="#555555">get BSO Product</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Create_New_Order_Allocation_Get_Related_Blanket_Sales_Order_Products", penwidth="1.2"];
  CALM_Create_New_Order_Allocation_Get_Related_Order_Allocation_Request [label=<Get Related Order<BR/>Allocation Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation Request</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Create_New_Order_Allocation_Get_Related_Order_Allocation_Request", penwidth="1.2"];
  CALM_Create_New_Order_Allocation_Create_Order_Allocation [label=<Create Order Allocation<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Create_New_Order_Allocation_Create_Order_Allocation", penwidth="1.2"];
  CALM_Create_New_Order_Allocation_Create_Order_Allocation_Products [label=<Create Order Allocation<BR/>Products<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Product</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Create_New_Order_Allocation_Create_Order_Allocation_Products", penwidth="2.6"];
  start -> CALM_Create_New_Order_Allocation_Get_Related_Order_Allocation_Request;
  CALM_Create_New_Order_Allocation_Create_New_Order_Allocation -> CALM_Create_New_Order_Allocation_Create_Order_Allocation [];
  CALM_Create_New_Order_Allocation_Check_if_Order_Allocation_Request_has_been_Submitted -> CALM_Create_New_Order_Allocation_Get_Blanket_Sales_Order [label="otherwise"];
  CALM_Create_New_Order_Allocation_Check_if_Order_Allocation_Request_has_been_Submitted -> CALM_Create_New_Order_Allocation_Allocation_Already_Submitted_Screen [label="Is Submitted"];
  CALM_Create_New_Order_Allocation_Loop_Blanket_Sales_Order_Products -> CALM_Create_New_Order_Allocation_Loop_Blanket_Sales_Order_Products [label="each", style="dashed"];
  CALM_Create_New_Order_Allocation_Loop_Blanket_Sales_Order_Products -> CALM_Create_New_Order_Allocation_Create_Order_Allocation_Products [label="done"];
  CALM_Create_New_Order_Allocation_Get_Blanket_Sales_Order -> CALM_Create_New_Order_Allocation_Create_New_Order_Allocation [];
  CALM_Create_New_Order_Allocation_Get_Newly_Created_Order_Allocation -> CALM_Create_New_Order_Allocation_Get_Related_Blanket_Sales_Order_Products [];
  CALM_Create_New_Order_Allocation_Get_Related_Blanket_Sales_Order_Products -> CALM_Create_New_Order_Allocation_Loop_Blanket_Sales_Order_Products [];
  CALM_Create_New_Order_Allocation_Get_Related_Order_Allocation_Request -> CALM_Create_New_Order_Allocation_Check_if_Order_Allocation_Request_has_been_Submitted [];
  CALM_Create_New_Order_Allocation_Create_Order_Allocation -> CALM_Create_New_Order_Allocation_Get_Newly_Created_Order_Allocation [];
}