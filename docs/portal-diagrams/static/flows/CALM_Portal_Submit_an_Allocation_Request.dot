digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_Submit_an_Allocation_Request_start"];
  CALM_Portal_Submit_an_Allocation_Request_Additional_Details_Needed [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Additional Details Needed<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable, flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Submit_an_Allocation_Request_Additional_Details_Needed", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Copy_1_of_Thank_you [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Copy 1 of Thank you>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Submit_an_Allocation_Request_Copy_1_of_Thank_you", penwidth="2.6"];
  CALM_Portal_Submit_an_Allocation_Request_Final_Confirmation [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Final Confirmation<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable, flowPortalTracker,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">fsc_flowButtonBar</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Submit_an_Allocation_Request_Final_Confirmation", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Thank_you [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Thank you>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Submit_an_Allocation_Request_Thank_you", penwidth="2.6"];
  CALM_Portal_Submit_an_Allocation_Request_Verify_and_Submit [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Verify and Submit<BR/><FONT POINT-SIZE="8" COLOR="#555555">allocationsTable_v2,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">fsc_flowButtonBar</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Submit_an_Allocation_Request_Verify_and_Submit", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Allocation_Yet_Needing_confirmation [label=<Allocation Yet<BR/>Needing<BR/>confirmation?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Submit_an_Allocation_Request_Allocation_Yet_Needing_confirmation", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_BtnBar_Navigation [label=<BtnBar Navigation>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Submit_an_Allocation_Request_BtnBar_Navigation", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_route_by_button [label=<route by button>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Submit_an_Allocation_Request_route_by_button", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Who_Submitted_Order [label=<Who Submitted<BR/>Order?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Submit_an_Allocation_Request_Who_Submitted_Order", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Who_to_Thank [label=<Who to Thank?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Submit_an_Allocation_Request_Who_to_Thank", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Loop_Order_Allocations [label=<<FONT POINT-SIZE="8" COLOR="#555555">LOOP</FONT><BR/>Loop Order Allocations>, shape="box", style="rounded,filled,dashed", fillcolor="#E8EAF6", color="#3949AB", class="n-loop", id="CALM_Portal_Submit_an_Allocation_Request_Loop_Order_Allocations", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Order_Allocation_Logistics_Flow [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Order<BR/>Allocation Modal>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Submit_an_Allocation_Request_Order_Allocation_Logistics_Flow", penwidth="2.6"];
  CALM_Portal_Submit_an_Allocation_Request_Get_Blanket_Sales_Order [label=<Get Blanket Sales Order<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Blanket Sales Order (BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Submit_an_Allocation_Request_Get_Blanket_Sales_Order", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Get_Blanket_Sales_Order_Products [label=<Get Blanket Sales Order<BR/>Products<BR/><FONT POINT-SIZE="8" COLOR="#555555">get BSO Product</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Submit_an_Allocation_Request_Get_Blanket_Sales_Order_Products", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocation_Products [label=<Get Order Allocation<BR/>Products<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation Product</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocation_Products", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocation_Request [label=<Get Order Allocation<BR/>Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation Request</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocation_Request", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocations [label=<Get Order Allocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation (site)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocations", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Copy_1_of_Unlock_Allocations [label=<Copy 1 of Unlock<BR/>Allocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Submit_an_Allocation_Request_Copy_1_of_Unlock_Allocations", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Unlock_Allocations [label=<Unlock Allocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Submit_an_Allocation_Request_Unlock_Allocations", penwidth="2.6"];
  CALM_Portal_Submit_an_Allocation_Request_Update_Allocation_Request_Status [label=<Update Allocation Request<BR/>Status<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Request (OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Submit_an_Allocation_Request_Update_Allocation_Request_Status", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Update_Allocation_Status_on_BSO [label=<Update Allocation Status<BR/>on BSO<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Blanket Sales Order</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Submit_an_Allocation_Request_Update_Allocation_Status_on_BSO", penwidth="1.2"];
  CALM_Portal_Submit_an_Allocation_Request_Update_Order_Allocations [label=<Update Order Allocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Submit_an_Allocation_Request_Update_Order_Allocations", penwidth="1.2"];
  start -> CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocation_Request;
  CALM_Portal_Submit_an_Allocation_Request_Additional_Details_Needed -> CALM_Portal_Submit_an_Allocation_Request_Order_Allocation_Logistics_Flow [];
  CALM_Portal_Submit_an_Allocation_Request_Final_Confirmation -> CALM_Portal_Submit_an_Allocation_Request_route_by_button [];
  CALM_Portal_Submit_an_Allocation_Request_Verify_and_Submit -> CALM_Portal_Submit_an_Allocation_Request_BtnBar_Navigation [];
  CALM_Portal_Submit_an_Allocation_Request_Allocation_Yet_Needing_confirmation -> CALM_Portal_Submit_an_Allocation_Request_Final_Confirmation [label="otherwise"];
  CALM_Portal_Submit_an_Allocation_Request_Allocation_Yet_Needing_confirmation -> CALM_Portal_Submit_an_Allocation_Request_Copy_1_of_Unlock_Allocations [label="Yes Require additional confirmation"];
  CALM_Portal_Submit_an_Allocation_Request_BtnBar_Navigation -> CALM_Portal_Submit_an_Allocation_Request_Unlock_Allocations [label="otherwise"];
  CALM_Portal_Submit_an_Allocation_Request_BtnBar_Navigation -> CALM_Portal_Submit_an_Allocation_Request_Who_Submitted_Order [label="Confirm and Submit"];
  CALM_Portal_Submit_an_Allocation_Request_route_by_button -> CALM_Portal_Submit_an_Allocation_Request_Unlock_Allocations [label="otherwise"];
  CALM_Portal_Submit_an_Allocation_Request_route_by_button -> CALM_Portal_Submit_an_Allocation_Request_Loop_Order_Allocations [label="Continue"];
  CALM_Portal_Submit_an_Allocation_Request_Who_Submitted_Order -> CALM_Portal_Submit_an_Allocation_Request_Update_Order_Allocations [label="otherwise"];
  CALM_Portal_Submit_an_Allocation_Request_Who_Submitted_Order -> CALM_Portal_Submit_an_Allocation_Request_Update_Order_Allocations [label="Internal Support"];
  CALM_Portal_Submit_an_Allocation_Request_Who_to_Thank -> CALM_Portal_Submit_an_Allocation_Request_Thank_you [label="otherwise"];
  CALM_Portal_Submit_an_Allocation_Request_Who_to_Thank -> CALM_Portal_Submit_an_Allocation_Request_Copy_1_of_Thank_you [label="Thank Internal Support"];
  CALM_Portal_Submit_an_Allocation_Request_Loop_Order_Allocations -> CALM_Portal_Submit_an_Allocation_Request_Loop_Order_Allocations [label="each", style="dashed"];
  CALM_Portal_Submit_an_Allocation_Request_Loop_Order_Allocations -> CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocation_Products [label="done"];
  CALM_Portal_Submit_an_Allocation_Request_Get_Blanket_Sales_Order -> CALM_Portal_Submit_an_Allocation_Request_Get_Blanket_Sales_Order_Products [];
  CALM_Portal_Submit_an_Allocation_Request_Get_Blanket_Sales_Order_Products -> CALM_Portal_Submit_an_Allocation_Request_Verify_and_Submit [];
  CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocation_Products -> CALM_Portal_Submit_an_Allocation_Request_Get_Blanket_Sales_Order [];
  CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocation_Request -> CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocations [];
  CALM_Portal_Submit_an_Allocation_Request_Get_Order_Allocations -> CALM_Portal_Submit_an_Allocation_Request_Allocation_Yet_Needing_confirmation [];
  CALM_Portal_Submit_an_Allocation_Request_Copy_1_of_Unlock_Allocations -> CALM_Portal_Submit_an_Allocation_Request_Additional_Details_Needed [];
  CALM_Portal_Submit_an_Allocation_Request_Update_Allocation_Request_Status -> CALM_Portal_Submit_an_Allocation_Request_Update_Allocation_Status_on_BSO [];
  CALM_Portal_Submit_an_Allocation_Request_Update_Allocation_Status_on_BSO -> CALM_Portal_Submit_an_Allocation_Request_Who_to_Thank [];
  CALM_Portal_Submit_an_Allocation_Request_Update_Order_Allocations -> CALM_Portal_Submit_an_Allocation_Request_Update_Allocation_Request_Status [];
}