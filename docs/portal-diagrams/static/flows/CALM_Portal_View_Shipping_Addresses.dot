digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_View_Shipping_Addresses_start"];
  CALM_Portal_View_Shipping_Addresses_No_Address_Record_Found [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>No Address Record Found>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_View_Shipping_Addresses_No_Address_Record_Found", penwidth="1.2"];
  CALM_Portal_View_Shipping_Addresses_Review_Shipping_Addresses [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Review Shipping Addresses<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">fsc_flowButtonBar</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_View_Shipping_Addresses_Review_Shipping_Addresses", penwidth="1.2"];
  CALM_Portal_View_Shipping_Addresses_How_many_shipping_addresses [label=<How many shipping<BR/>addresses?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_View_Shipping_Addresses_How_many_shipping_addresses", penwidth="1.2"];
  CALM_Portal_View_Shipping_Addresses_Navigate_to_New_or_Edit [label=<Navigate to New or<BR/>Edit?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_View_Shipping_Addresses_Navigate_to_New_or_Edit", penwidth="1.2"];
  CALM_Portal_View_Shipping_Addresses_Was_Address_Found [label=<Was Address Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_View_Shipping_Addresses_Was_Address_Found", penwidth="1.2"];
  CALM_Portal_View_Shipping_Addresses_Get_User_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_View_Shipping_Addresses_Get_User_Details", penwidth="1.2"];
  CALM_Portal_View_Shipping_Addresses_Launch_Edit_Shipping_Address [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Edit<BR/>Shipping Addresses>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_View_Shipping_Addresses_Launch_Edit_Shipping_Address", penwidth="1.2"];
  CALM_Portal_View_Shipping_Addresses_Launch_New_Shipping_Address [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Add New<BR/>Shipping Addresses>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_View_Shipping_Addresses_Launch_New_Shipping_Address", penwidth="1.2"];
  CALM_Portal_View_Shipping_Addresses_Getting_Shipping_Addresses_Related_to_Account [label=<Getting Shipping Addresses<BR/>Related to Account<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_View_Shipping_Addresses_Getting_Shipping_Addresses_Related_to_Account", penwidth="1.2"];
  start -> CALM_Portal_View_Shipping_Addresses_Get_User_Details;
  CALM_Portal_View_Shipping_Addresses_No_Address_Record_Found -> CALM_Portal_View_Shipping_Addresses_Getting_Shipping_Addresses_Related_to_Account [];
  CALM_Portal_View_Shipping_Addresses_Review_Shipping_Addresses -> CALM_Portal_View_Shipping_Addresses_Navigate_to_New_or_Edit [];
  CALM_Portal_View_Shipping_Addresses_How_many_shipping_addresses -> CALM_Portal_View_Shipping_Addresses_Review_Shipping_Addresses [label="otherwise"];
  CALM_Portal_View_Shipping_Addresses_How_many_shipping_addresses -> CALM_Portal_View_Shipping_Addresses_Launch_New_Shipping_Address [label="No Addresses Found"];
  CALM_Portal_View_Shipping_Addresses_Navigate_to_New_or_Edit -> CALM_Portal_View_Shipping_Addresses_Launch_New_Shipping_Address [label="otherwise"];
  CALM_Portal_View_Shipping_Addresses_Navigate_to_New_or_Edit -> CALM_Portal_View_Shipping_Addresses_Was_Address_Found [label="Edit Address"];
  CALM_Portal_View_Shipping_Addresses_Was_Address_Found -> CALM_Portal_View_Shipping_Addresses_Launch_Edit_Shipping_Address [label="otherwise"];
  CALM_Portal_View_Shipping_Addresses_Was_Address_Found -> CALM_Portal_View_Shipping_Addresses_No_Address_Record_Found [label="Not Found"];
  CALM_Portal_View_Shipping_Addresses_Get_User_Details -> CALM_Portal_View_Shipping_Addresses_Getting_Shipping_Addresses_Related_to_Account [];
  CALM_Portal_View_Shipping_Addresses_Launch_Edit_Shipping_Address -> CALM_Portal_View_Shipping_Addresses_Getting_Shipping_Addresses_Related_to_Account [];
  CALM_Portal_View_Shipping_Addresses_Launch_New_Shipping_Address -> CALM_Portal_View_Shipping_Addresses_Getting_Shipping_Addresses_Related_to_Account [];
  CALM_Portal_View_Shipping_Addresses_Getting_Shipping_Addresses_Related_to_Account -> CALM_Portal_View_Shipping_Addresses_How_many_shipping_addresses [];
}