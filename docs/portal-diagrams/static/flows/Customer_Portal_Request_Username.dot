digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="Customer_Portal_Request_Username_start"];
  Customer_Portal_Request_Username_endScren [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>endScren>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Customer_Portal_Request_Username_endScren", penwidth="2.6"];
  Customer_Portal_Request_Username_lookupUsername [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>lookupUsername<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">fsc_flowButtonBar</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Customer_Portal_Request_Username_lookupUsername", penwidth="1.2"];
  Customer_Portal_Request_Username_Decision_1 [label=<Route for Fault<BR/>Path>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Request_Username_Decision_1", penwidth="1.2"];
  Customer_Portal_Request_Username_Fault_Path_Screen_Flow_and_Logging [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>Customer Portal | Fault<BR/>Path Screen>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="Customer_Portal_Request_Username_Fault_Path_Screen_Flow_and_Logging", penwidth="2.6"];
  Customer_Portal_Request_Username_Find_Requested_Username [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>Customer Portal | Find<BR/>Requested Username>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="Customer_Portal_Request_Username_Find_Requested_Username", penwidth="1.2"];
  start -> Customer_Portal_Request_Username_lookupUsername;
  Customer_Portal_Request_Username_lookupUsername -> Customer_Portal_Request_Username_Find_Requested_Username [];
  Customer_Portal_Request_Username_Decision_1 -> Customer_Portal_Request_Username_Fault_Path_Screen_Flow_and_Logging [label="otherwise"];
  Customer_Portal_Request_Username_Decision_1 -> Customer_Portal_Request_Username_endScren [label="No Fault"];
  Customer_Portal_Request_Username_Find_Requested_Username -> Customer_Portal_Request_Username_Decision_1 [];
}