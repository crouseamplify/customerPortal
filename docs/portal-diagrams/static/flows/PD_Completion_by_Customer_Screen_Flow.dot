digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="PD_Completion_by_Customer_Screen_Flow_start"];
  PD_Completion_by_Customer_Screen_Flow_Bcrypt_Fail_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Bcrypt_Fail_Screen<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_by_Customer_Screen_Flow_Bcrypt_Fail_Screen", penwidth="2.6"];
  PD_Completion_by_Customer_Screen_Flow_Browser_Side_Hash [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Browser Side Hash<BR/><FONT POINT-SIZE="8" COLOR="#555555">bcryptLWC</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_by_Customer_Screen_Flow_Browser_Side_Hash", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Entered_Code [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Enter Code<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_by_Customer_Screen_Flow_Entered_Code", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Incorrect_Code [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Incorrect Code<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_by_Customer_Screen_Flow_Incorrect_Code", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_PII_Info [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>PII Info<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_by_Customer_Screen_Flow_PII_Info", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Success_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Success Screen<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_by_Customer_Screen_Flow_Success_Screen", penwidth="2.6"];
  PD_Completion_by_Customer_Screen_Flow_Hash_Success [label=<Hash Success?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Completion_by_Customer_Screen_Flow_Hash_Success", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Service_Appointment_Found [label=<Service<BR/>Appointment Found>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Completion_by_Customer_Screen_Flow_Service_Appointment_Found", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Generate_SHA256_Hash [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Generate SHA256 Hash<BR/><FONT POINT-SIZE="8" COLOR="#555555">securehash__CryptoHashGenerator</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="PD_Completion_by_Customer_Screen_Flow_Generate_SHA256_Hash", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Get_CALM_Automation_Defaults [label=<Get CALM Automation<BR/>Defaults<BR/><FONT POINT-SIZE="8" COLOR="#555555">get CMDT: CALM Automation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Defaults</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Completion_by_Customer_Screen_Flow_Get_CALM_Automation_Defaults", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Get_PD_Completion_Metadata [label=<Get PD Completion Metadata<BR/><FONT POINT-SIZE="8" COLOR="#555555">get CMDT: PD Completion</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Default</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Completion_by_Customer_Screen_Flow_Get_PD_Completion_Metadata", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Get_Service_Appointment [label=<Get Service Appointment<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Service Appointment</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Completion_by_Customer_Screen_Flow_Get_Service_Appointment", penwidth="1.2"];
  PD_Completion_by_Customer_Screen_Flow_Create_PD_Completion [label=<Create PD Completion<BR/><FONT POINT-SIZE="8" COLOR="#555555">create PD Completion</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="PD_Completion_by_Customer_Screen_Flow_Create_PD_Completion", penwidth="1.2"];
  start -> PD_Completion_by_Customer_Screen_Flow_Get_CALM_Automation_Defaults;
  PD_Completion_by_Customer_Screen_Flow_Browser_Side_Hash -> PD_Completion_by_Customer_Screen_Flow_Hash_Success [];
  PD_Completion_by_Customer_Screen_Flow_Entered_Code -> PD_Completion_by_Customer_Screen_Flow_Get_Service_Appointment [];
  PD_Completion_by_Customer_Screen_Flow_Incorrect_Code -> PD_Completion_by_Customer_Screen_Flow_Entered_Code [];
  PD_Completion_by_Customer_Screen_Flow_PII_Info -> PD_Completion_by_Customer_Screen_Flow_Get_PD_Completion_Metadata [];
  PD_Completion_by_Customer_Screen_Flow_Hash_Success -> PD_Completion_by_Customer_Screen_Flow_Create_PD_Completion [label="otherwise"];
  PD_Completion_by_Customer_Screen_Flow_Hash_Success -> PD_Completion_by_Customer_Screen_Flow_Bcrypt_Fail_Screen [label="Failure"];
  PD_Completion_by_Customer_Screen_Flow_Service_Appointment_Found -> PD_Completion_by_Customer_Screen_Flow_Incorrect_Code [label="otherwise"];
  PD_Completion_by_Customer_Screen_Flow_Service_Appointment_Found -> PD_Completion_by_Customer_Screen_Flow_PII_Info [label="SA Found"];
  PD_Completion_by_Customer_Screen_Flow_Generate_SHA256_Hash -> PD_Completion_by_Customer_Screen_Flow_Browser_Side_Hash [];
  PD_Completion_by_Customer_Screen_Flow_Get_CALM_Automation_Defaults -> PD_Completion_by_Customer_Screen_Flow_Entered_Code [];
  PD_Completion_by_Customer_Screen_Flow_Get_PD_Completion_Metadata -> PD_Completion_by_Customer_Screen_Flow_Generate_SHA256_Hash [];
  PD_Completion_by_Customer_Screen_Flow_Get_Service_Appointment -> PD_Completion_by_Customer_Screen_Flow_Service_Appointment_Found [];
  PD_Completion_by_Customer_Screen_Flow_Create_PD_Completion -> PD_Completion_by_Customer_Screen_Flow_Success_Screen [];
}