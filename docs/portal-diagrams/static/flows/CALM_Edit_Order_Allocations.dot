digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Edit_Order_Allocations_start"];
  CALM_Edit_Order_Allocations_Cancel_Allocation_Request_Warning [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Cancel Allocation Request<BR/>Warning>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_Cancel_Allocation_Request_Warning", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Confirm_First_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Confirm_First_Screen<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable, fsc_flowButtonBar</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_Confirm_First_Screen", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Correction_Needed_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Correction_Needed_Screen>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_Correction_Needed_Screen", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Edit_Order_Allocation_Request [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Edit Order Allocation<BR/>Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">fsc_flowButtonBar</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_Edit_Order_Allocation_Request", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Not_Materials_Contact [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Not Materials Contact>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_Not_Materials_Contact", penwidth="2.6"];
  CALM_Edit_Order_Allocations_OA_Record_Not_Found [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>OA Record Not Found<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_OA_Record_Not_Found", penwidth="2.6"];
  CALM_Edit_Order_Allocations_OAR_Record_Not_Found [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>OAR Record Not Found<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_OAR_Record_Not_Found", penwidth="2.6"];
  CALM_Edit_Order_Allocations_Product_Records_Not_Found [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Product Records Not Found<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_Product_Records_Not_Found", penwidth="2.6"];
  CALM_Edit_Order_Allocations_Review_Submitted_Orders [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Review Submitted Orders<BR/><FONT POINT-SIZE="8" COLOR="#555555">allocationsTable_v2,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_Review_Submitted_Orders", penwidth="2.6"];
  CALM_Edit_Order_Allocations_User_Conflict_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>User Conflict Screen>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Edit_Order_Allocations_User_Conflict_Screen", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Button_Navigation_Decision [label=<Button Navigation<BR/>Decision>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Button_Navigation_Decision", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Cancel_Any_Order_Allocations [label=<Cancel Any Order<BR/>Allocations?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Cancel_Any_Order_Allocations", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Check_for_Over_Allocation_BSO_Products [label=<Check for Over<BR/>Allocation BSO<BR/>Products>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Check_for_Over_Allocation_BSO_Products", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Compare_Timestamps [label=<Compare Timestamps>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Compare_Timestamps", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Does_Canceled_Equal_Available [label=<Does Canceled<BR/>Equal Available?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Does_Canceled_Equal_Available", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Has_OAR_Been_Submitted [label=<Has OAR Been<BR/>Submitted?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Has_OAR_Been_Submitted", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Is_Flow_Triggered_by_Internal_User [label=<Is Flow Triggered<BR/>by Internal User?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Is_Flow_Triggered_by_Internal_User", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Order_Allocations_Found [label=<Order Allocations<BR/>Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Order_Allocations_Found", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Submitted_by_Materials_Contact_or_Amplify [label=<Submitted by<BR/>Materials Contact<BR/>or Amplify?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Submitted_by_Materials_Contact_or_Amplify", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Unconfirmed_Allocations_found [label=<Unconfirmed<BR/>Allocations found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Unconfirmed_Allocations_found", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Was_OAR_Found [label=<Was OAR Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Was_OAR_Found", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Was_Submission_Cancelled [label=<Was Submission<BR/>Cancelled?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Was_Submission_Cancelled", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Were_Order_Allocation_Products_Found [label=<Were Order<BR/>Allocation<BR/>Products Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Edit_Order_Allocations_Were_Order_Allocation_Products_Found", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Loop_Through_Order_Allocations [label=<<FONT POINT-SIZE="8" COLOR="#555555">LOOP</FONT><BR/>Loop Through Order<BR/>Allocations>, shape="box", style="rounded,filled,dashed", fillcolor="#E8EAF6", color="#3949AB", class="n-loop", id="CALM_Edit_Order_Allocations_Loop_Through_Order_Allocations", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_Contact_Detail [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Edit_Order_Allocations_Get_Contact_Detail", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Launch_Logistics_for_Allocation [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Order<BR/>Allocation Modal>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Edit_Order_Allocations_Launch_Logistics_for_Allocation", penwidth="2.6"];
  CALM_Edit_Order_Allocations_Submit_Allocation_Request [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Submit an<BR/>Allocation Request>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Edit_Order_Allocations_Submit_Allocation_Request", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Check_for_Unconfirmed_Allocations [label=<Check for Unconfirmed<BR/>Allocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation (site)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Check_for_Unconfirmed_Allocations", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_Blanket_Sales_Order [label=<Get Blanket Sales Order<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Blanket Sales Order (BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_Blanket_Sales_Order", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_BSO_Products [label=<Get BSO Products<BR/><FONT POINT-SIZE="8" COLOR="#555555">get BSO Product</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_BSO_Products", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_BSO_Products_for_Review [label=<Get BSO Products for<BR/>Review<BR/><FONT POINT-SIZE="8" COLOR="#555555">get BSO Product</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_BSO_Products_for_Review", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_CALM_Automation_Defaults [label=<Get CALM Automation<BR/>Defaults<BR/><FONT POINT-SIZE="8" COLOR="#555555">get CMDT: CALM Automation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Defaults</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_CALM_Automation_Defaults", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_Contact_Record [label=<Get Contact Record<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_Contact_Record", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_Latest_Timestamp [label=<Get Latest Timestamp<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Blanket Sales Order (BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_Latest_Timestamp", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_New_Count_of_Order_Allocations [label=<Get New Count of Order<BR/>Allocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation Request</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_New_Count_of_Order_Allocations", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_Order_Allocation_Products [label=<Get Order Allocation<BR/>Products<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation Product</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_Order_Allocation_Products", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_Order_Allocation_Request [label=<Get Order Allocation<BR/>Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation Request</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_Order_Allocation_Request", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_Order_Allocations [label=<Get Order Allocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation (site)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_Order_Allocations", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Get_overallocations [label=<Get overallocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">get BSO Product</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Edit_Order_Allocations_Get_overallocations", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Cancel_Order_Allocation_Request [label=<Cancel Order Allocation<BR/>Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Request (OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Edit_Order_Allocations_Cancel_Order_Allocation_Request", penwidth="2.6"];
  CALM_Edit_Order_Allocations_Copy_1_of_Set_Order_Allocations_to_Cancelled [label=<Copy 1 of Set Order<BR/>Allocations to Cancelled<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site) *</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Edit_Order_Allocations_Copy_1_of_Set_Order_Allocations_to_Cancelled", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Lock_Order_Allocations [label=<Lock Order Allocations<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Edit_Order_Allocations_Lock_Order_Allocations", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Set_Order_Allocations_to_Cancelle [label=<Set Order Allocations to<BR/>Cancelled<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site) *</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Edit_Order_Allocations_Set_Order_Allocations_to_Cancelle", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Update_BSO_Allocation_Status_to_Saved [label=<Update BSO Allocation<BR/>Status to Saved<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Blanket Sales Order</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Edit_Order_Allocations_Update_BSO_Allocation_Status_to_Saved", penwidth="1.2"];
  CALM_Edit_Order_Allocations_Update_Order_Allocation_Products [label=<Update Order Allocation<BR/>Products<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Product *</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Edit_Order_Allocations_Update_Order_Allocation_Products", penwidth="1.2"];
  start -> CALM_Edit_Order_Allocations_Get_CALM_Automation_Defaults;
  CALM_Edit_Order_Allocations_Cancel_Allocation_Request_Warning -> CALM_Edit_Order_Allocations_Copy_1_of_Set_Order_Allocations_to_Cancelled [];
  CALM_Edit_Order_Allocations_Confirm_First_Screen -> CALM_Edit_Order_Allocations_Launch_Logistics_for_Allocation [];
  CALM_Edit_Order_Allocations_Correction_Needed_Screen -> CALM_Edit_Order_Allocations_Get_Order_Allocation_Request [];
  CALM_Edit_Order_Allocations_Edit_Order_Allocation_Request -> CALM_Edit_Order_Allocations_Get_Latest_Timestamp [];
  CALM_Edit_Order_Allocations_User_Conflict_Screen -> CALM_Edit_Order_Allocations_Get_Order_Allocation_Request [];
  CALM_Edit_Order_Allocations_Button_Navigation_Decision -> CALM_Edit_Order_Allocations_Get_Order_Allocation_Request [label="Save and Stay"];
  CALM_Edit_Order_Allocations_Button_Navigation_Decision -> CALM_Edit_Order_Allocations_Check_for_Unconfirmed_Allocations [label="Confirm"];
  CALM_Edit_Order_Allocations_Cancel_Any_Order_Allocations -> CALM_Edit_Order_Allocations_Button_Navigation_Decision [label="otherwise"];
  CALM_Edit_Order_Allocations_Cancel_Any_Order_Allocations -> CALM_Edit_Order_Allocations_Get_New_Count_of_Order_Allocations [label="Cancel OA"];
  CALM_Edit_Order_Allocations_Check_for_Over_Allocation_BSO_Products -> CALM_Edit_Order_Allocations_Submitted_by_Materials_Contact_or_Amplify [label="otherwise"];
  CALM_Edit_Order_Allocations_Check_for_Over_Allocation_BSO_Products -> CALM_Edit_Order_Allocations_Correction_Needed_Screen [label="Over Allocated"];
  CALM_Edit_Order_Allocations_Compare_Timestamps -> CALM_Edit_Order_Allocations_Update_BSO_Allocation_Status_to_Saved [label="otherwise"];
  CALM_Edit_Order_Allocations_Compare_Timestamps -> CALM_Edit_Order_Allocations_User_Conflict_Screen [label="Prevent Edits"];
  CALM_Edit_Order_Allocations_Does_Canceled_Equal_Available -> CALM_Edit_Order_Allocations_Set_Order_Allocations_to_Cancelle [label="otherwise"];
  CALM_Edit_Order_Allocations_Does_Canceled_Equal_Available -> CALM_Edit_Order_Allocations_Cancel_Allocation_Request_Warning [label="Greater Than or Equal"];
  CALM_Edit_Order_Allocations_Has_OAR_Been_Submitted -> CALM_Edit_Order_Allocations_Get_BSO_Products [label="otherwise"];
  CALM_Edit_Order_Allocations_Has_OAR_Been_Submitted -> CALM_Edit_Order_Allocations_Get_BSO_Products_for_Review [label="Submitted"];
  CALM_Edit_Order_Allocations_Is_Flow_Triggered_by_Internal_User -> CALM_Edit_Order_Allocations_Get_Contact_Detail [label="otherwise"];
  CALM_Edit_Order_Allocations_Is_Flow_Triggered_by_Internal_User -> CALM_Edit_Order_Allocations_Get_Order_Allocation_Request [label="Internal User"];
  CALM_Edit_Order_Allocations_Order_Allocations_Found -> CALM_Edit_Order_Allocations_OA_Record_Not_Found [label="otherwise"];
  CALM_Edit_Order_Allocations_Order_Allocations_Found -> CALM_Edit_Order_Allocations_Loop_Through_Order_Allocations [label="OA Found"];
  CALM_Edit_Order_Allocations_Submitted_by_Materials_Contact_or_Amplify -> CALM_Edit_Order_Allocations_Not_Materials_Contact [label="otherwise"];
  CALM_Edit_Order_Allocations_Submitted_by_Materials_Contact_or_Amplify -> CALM_Edit_Order_Allocations_Lock_Order_Allocations [label="Materials Contact"];
  CALM_Edit_Order_Allocations_Unconfirmed_Allocations_found -> CALM_Edit_Order_Allocations_Get_overallocations [label="otherwise"];
  CALM_Edit_Order_Allocations_Unconfirmed_Allocations_found -> CALM_Edit_Order_Allocations_Confirm_First_Screen [label="Found Unconfirmed"];
  CALM_Edit_Order_Allocations_Was_OAR_Found -> CALM_Edit_Order_Allocations_OAR_Record_Not_Found [label="otherwise"];
  CALM_Edit_Order_Allocations_Was_OAR_Found -> CALM_Edit_Order_Allocations_Get_Order_Allocations [label="OAR Found"];
  CALM_Edit_Order_Allocations_Was_Submission_Cancelled -> CALM_Edit_Order_Allocations_Is_Flow_Triggered_by_Internal_User [label="User Cancelled"];
  CALM_Edit_Order_Allocations_Were_Order_Allocation_Products_Found -> CALM_Edit_Order_Allocations_Get_Blanket_Sales_Order [label="otherwise"];
  CALM_Edit_Order_Allocations_Were_Order_Allocation_Products_Found -> CALM_Edit_Order_Allocations_Product_Records_Not_Found [label="No Products"];
  CALM_Edit_Order_Allocations_Loop_Through_Order_Allocations -> CALM_Edit_Order_Allocations_Loop_Through_Order_Allocations [label="each", style="dashed"];
  CALM_Edit_Order_Allocations_Loop_Through_Order_Allocations -> CALM_Edit_Order_Allocations_Get_Order_Allocation_Products [label="done"];
  CALM_Edit_Order_Allocations_Get_Contact_Detail -> CALM_Edit_Order_Allocations_Get_Contact_Record [];
  CALM_Edit_Order_Allocations_Submit_Allocation_Request -> CALM_Edit_Order_Allocations_Was_Submission_Cancelled [];
  CALM_Edit_Order_Allocations_Check_for_Unconfirmed_Allocations -> CALM_Edit_Order_Allocations_Unconfirmed_Allocations_found [];
  CALM_Edit_Order_Allocations_Get_Blanket_Sales_Order -> CALM_Edit_Order_Allocations_Has_OAR_Been_Submitted [];
  CALM_Edit_Order_Allocations_Get_BSO_Products -> CALM_Edit_Order_Allocations_Edit_Order_Allocation_Request [];
  CALM_Edit_Order_Allocations_Get_BSO_Products_for_Review -> CALM_Edit_Order_Allocations_Review_Submitted_Orders [];
  CALM_Edit_Order_Allocations_Get_CALM_Automation_Defaults -> CALM_Edit_Order_Allocations_Is_Flow_Triggered_by_Internal_User [];
  CALM_Edit_Order_Allocations_Get_Contact_Record -> CALM_Edit_Order_Allocations_Get_Order_Allocation_Request [];
  CALM_Edit_Order_Allocations_Get_Latest_Timestamp -> CALM_Edit_Order_Allocations_Compare_Timestamps [];
  CALM_Edit_Order_Allocations_Get_New_Count_of_Order_Allocations -> CALM_Edit_Order_Allocations_Does_Canceled_Equal_Available [];
  CALM_Edit_Order_Allocations_Get_Order_Allocation_Products -> CALM_Edit_Order_Allocations_Were_Order_Allocation_Products_Found [];
  CALM_Edit_Order_Allocations_Get_Order_Allocation_Request -> CALM_Edit_Order_Allocations_Was_OAR_Found [];
  CALM_Edit_Order_Allocations_Get_Order_Allocations -> CALM_Edit_Order_Allocations_Order_Allocations_Found [];
  CALM_Edit_Order_Allocations_Get_overallocations -> CALM_Edit_Order_Allocations_Check_for_Over_Allocation_BSO_Products [];
  CALM_Edit_Order_Allocations_Copy_1_of_Set_Order_Allocations_to_Cancelled -> CALM_Edit_Order_Allocations_Cancel_Order_Allocation_Request [];
  CALM_Edit_Order_Allocations_Lock_Order_Allocations -> CALM_Edit_Order_Allocations_Submit_Allocation_Request [];
  CALM_Edit_Order_Allocations_Set_Order_Allocations_to_Cancelle -> CALM_Edit_Order_Allocations_Button_Navigation_Decision [];
  CALM_Edit_Order_Allocations_Update_BSO_Allocation_Status_to_Saved -> CALM_Edit_Order_Allocations_Update_Order_Allocation_Products [];
  CALM_Edit_Order_Allocations_Update_Order_Allocation_Products -> CALM_Edit_Order_Allocations_Cancel_Any_Order_Allocations [];
}