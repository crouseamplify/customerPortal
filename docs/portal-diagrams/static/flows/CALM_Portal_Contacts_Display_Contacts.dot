digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_Contacts_Display_Contacts_start"];
  CALM_Portal_Contacts_Display_Contacts_Already_Invited_Alert [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Already Invited Alert>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Contacts_Display_Contacts_Already_Invited_Alert", penwidth="2.6"];
  CALM_Portal_Contacts_Display_Contacts_Display_Contacts [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Display Contacts<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable, flowPortalTracker,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">fsc_flowButtonBar</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Contacts_Display_Contacts_Display_Contacts", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Edit_Contact_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Edit Contact Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Contacts_Display_Contacts_Edit_Contact_Details", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Internal_Invite_User_to_Portal [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Internal Invite User to<BR/>Portal>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Contacts_Display_Contacts_Internal_Invite_User_to_Portal", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_No_Contact_Error_Internal [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>No Contact Error Internal>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Contacts_Display_Contacts_No_Contact_Error_Internal", penwidth="2.6"];
  CALM_Portal_Contacts_Display_Contacts_Success_Internal [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Success Internal>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Contacts_Display_Contacts_Success_Internal", penwidth="2.6"];
  CALM_Portal_Contacts_Display_Contacts_Add_or_Edit_Contacts [label=<Add or Edit<BR/>Contacts?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Add_or_Edit_Contacts", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Assign_Contact_Type_Values [label=<Assign Contact<BR/>Type Values>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Assign_Contact_Type_Values", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Deactivate_or_Remove_Access_From_Contact [label=<Deactivate or<BR/>Remove Access From<BR/>Contact?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Deactivate_or_Remove_Access_From_Contact", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Did_Any_Details_Change [label=<Did Any Details<BR/>Change?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Did_Any_Details_Change", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Found_duplicate_to_Edit [label=<Found duplicate to<BR/>Edit?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Found_duplicate_to_Edit", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Internal_Only_Has_Contact_Been_Invited [label=<Internal Only -<BR/>Has Contact Been<BR/>Invited?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Internal_Only_Has_Contact_Been_Invited", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Is_Internal_User_Editing [label=<Is Internal User<BR/>Editing?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Is_Internal_User_Editing", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Is_Internal_User_Saving [label=<Is Internal User<BR/>Saving?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Is_Internal_User_Saving", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Was_Flow_Triggered_by_Internal_User [label=<Was Flow Triggered<BR/>by Internal User?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Contacts_Display_Contacts_Was_Flow_Triggered_by_Internal_User", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Customer_Portal_Fault_Path_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>Customer Portal | Fault<BR/>Path Screen>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Contacts_Display_Contacts_Customer_Portal_Fault_Path_Screen", penwidth="2.6"];
  CALM_Portal_Contacts_Display_Contacts_Get_User_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Contacts_Display_Contacts_Get_User_Details", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_New_Contact [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | New Contact>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Contacts_Display_Contacts_New_Contact", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Convert_current_Contact_Type_to_Collection [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Convert current Contact<BR/>Type to Collection<BR/><FONT POINT-SIZE="8" COLOR="#555555">ConvertToStringCollection</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="CALM_Portal_Contacts_Display_Contacts_Convert_current_Contact_Type_to_Collection", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_convert_edit_list_to_collection [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>convert edit list to<BR/>collection<BR/><FONT POINT-SIZE="8" COLOR="#555555">ConvertToStringCollection</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="CALM_Portal_Contacts_Display_Contacts_convert_edit_list_to_collection", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_convert_Selected_Types_to_collection [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>convert Selected Types to<BR/>collection<BR/><FONT POINT-SIZE="8" COLOR="#555555">ConvertToStringCollection</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="CALM_Portal_Contacts_Display_Contacts_convert_Selected_Types_to_collection", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Convert_Updated_Contact_Type_to_String [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Convert Updated Contact<BR/>Type to String<BR/><FONT POINT-SIZE="8" COLOR="#555555">ConvertStringCollectionToCSV_CP</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="CALM_Portal_Contacts_Display_Contacts_Convert_Updated_Contact_Type_to_String", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Get_Contact_Details [label=<Get Contact Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Contacts_Display_Contacts_Get_Contact_Details", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Get_Current_User_s_Contact [label=<Get Current User's Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Contacts_Display_Contacts_Get_Current_User_s_Contact", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Get_Primary_and_Child_Account_Contacts [label=<Get Primary and Child<BR/>Account Contacts<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Contacts_Display_Contacts_Get_Primary_and_Child_Account_Contacts", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Create_Platform_Event_to_Deactivate_User [label=<Create Platform Event to<BR/>Deactivate User<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Event: Deactivate</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Portal User</FONT>>, shape="cylinder", style="filled", fillcolor="#F8BBD0", color="#880E4F", class="n-event", id="CALM_Portal_Contacts_Display_Contacts_Create_Platform_Event_to_Deactivate_User", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Internal_User_Update_Edited_Contacts [label=<Internal User Update<BR/>Edited Contacts<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Contacts_Display_Contacts_Internal_User_Update_Edited_Contacts", penwidth="1.2"];
  CALM_Portal_Contacts_Display_Contacts_Update_Edited_Contacts [label=<Update Edited Contacts<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Contacts_Display_Contacts_Update_Edited_Contacts", penwidth="1.2"];
