digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="Customer_Portal_Find_Username_start"];
  Customer_Portal_Find_Username_Is_User_Email_Verified [label=<Is User Email<BR/>Verified?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Find_Username_Is_User_Email_Verified", penwidth="1.2"];
  Customer_Portal_Find_Username_Was_Active_User_Found [label=<Was Active User<BR/>Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Find_Username_Was_Active_User_Found", penwidth="1.2"];
  Customer_Portal_Find_Username_Send_No_User_Found [label=<<FONT POINT-SIZE="8" COLOR="#555555">EMAIL</FONT><BR/>Send No User Found<BR/><FONT POINT-SIZE="8" COLOR="#555555">emailSimple</FONT>>, shape="box", style="filled", fillcolor="#FCE4EC", color="#AD1457", class="n-email", id="Customer_Portal_Find_Username_Send_No_User_Found", penwidth="2.6"];
  Customer_Portal_Find_Username_Send_Username [label=<<FONT POINT-SIZE="8" COLOR="#555555">EMAIL</FONT><BR/>Send Username<BR/><FONT POINT-SIZE="8" COLOR="#555555">emailSimple</FONT>>, shape="box", style="filled", fillcolor="#FCE4EC", color="#AD1457", class="n-email", id="Customer_Portal_Find_Username_Send_Username", penwidth="2.6"];
  Customer_Portal_Find_Username_Send_Username_Verification_Reminder [label=<<FONT POINT-SIZE="8" COLOR="#555555">EMAIL</FONT><BR/>Send Username +<BR/>Verification Reminder<BR/><FONT POINT-SIZE="8" COLOR="#555555">emailSimple</FONT>>, shape="box", style="filled", fillcolor="#FCE4EC", color="#AD1457", class="n-email", id="Customer_Portal_Find_Username_Send_Username_Verification_Reminder", penwidth="2.6"];
  Customer_Portal_Find_Username_Send_Verification_Email [label=<<FONT POINT-SIZE="8" COLOR="#555555">EMAIL</FONT><BR/>Send Verification Email<BR/><FONT POINT-SIZE="8" COLOR="#555555">SendEmailVerification</FONT>>, shape="box", style="filled", fillcolor="#FCE4EC", color="#AD1457", class="n-email", id="Customer_Portal_Find_Username_Send_Verification_Email", penwidth="1.2"];
  Customer_Portal_Find_Username_Get_Email_Template [label=<Get Email Template<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Email Template</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Find_Username_Get_Email_Template", penwidth="1.2"];
  Customer_Portal_Find_Username_Get_Site_ID [label=<Get Site ID<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Network (site)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Find_Username_Get_Site_ID", penwidth="1.2"];
  Customer_Portal_Find_Username_Get_Username [label=<Get Username<BR/><FONT POINT-SIZE="8" COLOR="#555555">get User</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Find_Username_Get_Username", penwidth="1.2"];
  start -> Customer_Portal_Find_Username_Get_Username;
  Customer_Portal_Find_Username_Is_User_Email_Verified -> Customer_Portal_Find_Username_Get_Email_Template [label="otherwise"];
  Customer_Portal_Find_Username_Is_User_Email_Verified -> Customer_Portal_Find_Username_Send_Username [label="Email Verified"];
  Customer_Portal_Find_Username_Was_Active_User_Found -> Customer_Portal_Find_Username_Is_User_Email_Verified [label="otherwise"];
  Customer_Portal_Find_Username_Was_Active_User_Found -> Customer_Portal_Find_Username_Send_No_User_Found [label="User Not Found"];
  Customer_Portal_Find_Username_Send_Verification_Email -> Customer_Portal_Find_Username_Send_Username_Verification_Reminder [];
  Customer_Portal_Find_Username_Get_Email_Template -> Customer_Portal_Find_Username_Get_Site_ID [];
  Customer_Portal_Find_Username_Get_Site_ID -> Customer_Portal_Find_Username_Send_Verification_Email [];
  Customer_Portal_Find_Username_Get_Username -> Customer_Portal_Find_Username_Was_Active_User_Found [];
}