digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="PD_Request_Customer_Portal_Change_Request_start"];
  PD_Request_Customer_Portal_Change_Request_Go_back_to_update [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Go back to update>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_Customer_Portal_Change_Request_Go_back_to_update", penwidth="2.6"];
  PD_Request_Customer_Portal_Change_Request_Make_Updates [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Make Updates>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_Customer_Portal_Change_Request_Make_Updates", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_No_PD_to_schedule [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>No PD to schedule<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_Customer_Portal_Change_Request_No_PD_to_schedule", penwidth="2.6"];
  PD_Request_Customer_Portal_Change_Request_None_Selected [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>None Selected>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_Customer_Portal_Change_Request_None_Selected", penwidth="2.6"];
  PD_Request_Customer_Portal_Change_Request_SA_Screen_More_Info [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>SA Screen More Info>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_Customer_Portal_Change_Request_SA_Screen_More_Info", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Select_SAs_to_Edit [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Select SAs to Edit<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_Customer_Portal_Change_Request_Select_SAs_to_Edit", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Thank_You_for_Submitting_Request [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Thank You for Submitting<BR/>Request>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_Customer_Portal_Change_Request_Thank_You_for_Submitting_Request", penwidth="2.6"];
  PD_Request_Customer_Portal_Change_Request_Thank_You_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Thank You Screen>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_Customer_Portal_Change_Request_Thank_You_Screen", penwidth="2.6"];
  PD_Request_Customer_Portal_Change_Request_PD_Session_Topics_Found [label=<PD Session Topics<BR/>Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Request_Customer_Portal_Change_Request_PD_Session_Topics_Found", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_SAs_Found_Decision [label=<SAs Found>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Request_Customer_Portal_Change_Request_SAs_Found_Decision", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Were_any_SAs_updated [label=<Were any SAs<BR/>updated?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Request_Customer_Portal_Change_Request_Were_any_SAs_updated", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Were_any_sessions_selected [label=<Were any sessions<BR/>selected?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Request_Customer_Portal_Change_Request_Were_any_sessions_selected", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_PD_Session_Topics_to_create_Connector [label=<<FONT POINT-SIZE="8" COLOR="#555555">LOOP</FONT><BR/>Loop through PD Session<BR/>Topics to create Connector>, shape="box", style="rounded,filled,dashed", fillcolor="#E8EAF6", color="#3949AB", class="n-loop", id="PD_Request_Customer_Portal_Change_Request_Loop_through_PD_Session_Topics_to_create_Connector", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_Reactive_Collection [label=<<FONT POINT-SIZE="8" COLOR="#555555">LOOP</FONT><BR/>Loop through SAs Reactive<BR/>Collection>, shape="box", style="rounded,filled,dashed", fillcolor="#E8EAF6", color="#3949AB", class="n-loop", id="PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_Reactive_Collection", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_to_create_PDR_SA_Connector [label=<<FONT POINT-SIZE="8" COLOR="#555555">LOOP</FONT><BR/>Loop through SAs to create<BR/>PDR SA Connector>, shape="box", style="rounded,filled,dashed", fillcolor="#E8EAF6", color="#3949AB", class="n-loop", id="PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_to_create_PDR_SA_Connector", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_Sorted_SAs [label=<<FONT POINT-SIZE="8" COLOR="#555555">LOOP</FONT><BR/>Loop through Sorted SAs>, shape="box", style="rounded,filled,dashed", fillcolor="#E8EAF6", color="#3949AB", class="n-loop", id="PD_Request_Customer_Portal_Change_Request_Loop_through_Sorted_SAs", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Get_User_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="PD_Request_Customer_Portal_Change_Request_Get_User_Details", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Get_PD_Request_Record_Type [label=<Get PD Request Record Type<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Record Type</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Request_Customer_Portal_Change_Request_Get_PD_Request_Record_Type", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Get_PD_Session_Topic_Records [label=<Get PD Session Topic<BR/>Records<BR/><FONT POINT-SIZE="8" COLOR="#555555">get PD Session Topic</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Request_Customer_Portal_Change_Request_Get_PD_Session_Topic_Records", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Get_Requested_SAs [label=<Get Requested SAs<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Service Appointment</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Request_Customer_Portal_Change_Request_Get_Requested_SAs", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Get_scheduled_SAs [label=<Get scheduled SAs<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Service Appointment</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Request_Customer_Portal_Change_Request_Get_scheduled_SAs", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Get_User_s_Contact_Record [label=<Get User's Contact Record<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Request_Customer_Portal_Change_Request_Get_User_s_Contact_Record", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Create_PD_Request [label=<Create PD Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">create PD_Request__c</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="PD_Request_Customer_Portal_Change_Request_Create_PD_Request", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Create_PDR_SA_Connector [label=<Create PDR SA Connector<BR/><FONT POINT-SIZE="8" COLOR="#555555">create PDR_SA_Connector__c</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="PD_Request_Customer_Portal_Change_Request_Create_PDR_SA_Connector", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Create_PDR_Session_Topic_Connector [label=<Create PDR Session Topic<BR/>Connector<BR/><FONT POINT-SIZE="8" COLOR="#555555">create</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">PDR_Session_Topic_Connector__c</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="PD_Request_Customer_Portal_Change_Request_Create_PDR_Session_Topic_Connector", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Update_Reactive_SAs_Collection [label=<Update Reactive SAs<BR/>Collection<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Service Appointment *</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="PD_Request_Customer_Portal_Change_Request_Update_Reactive_SAs_Collection", penwidth="1.2"];
  PD_Request_Customer_Portal_Change_Request_Update_Toggle_Change_to_False_on_SAs [label=<Update Toggle Change to<BR/>False on SAs<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Service Appointment</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="PD_Request_Customer_Portal_Change_Request_Update_Toggle_Change_to_False_on_SAs", penwidth="1.2"];
  start -> PD_Request_Customer_Portal_Change_Request_Get_User_Details;
  PD_Request_Customer_Portal_Change_Request_Make_Updates -> PD_Request_Customer_Portal_Change_Request_Were_any_SAs_updated [];
  PD_Request_Customer_Portal_Change_Request_SA_Screen_More_Info -> PD_Request_Customer_Portal_Change_Request_Get_PD_Request_Record_Type [];
  PD_Request_Customer_Portal_Change_Request_Select_SAs_to_Edit -> PD_Request_Customer_Portal_Change_Request_Were_any_sessions_selected [];
  PD_Request_Customer_Portal_Change_Request_PD_Session_Topics_Found -> PD_Request_Customer_Portal_Change_Request_Thank_You_Screen [label="otherwise"];
  PD_Request_Customer_Portal_Change_Request_PD_Session_Topics_Found -> PD_Request_Customer_Portal_Change_Request_Loop_through_PD_Session_Topics_to_create_Connector [label="Founds PD Session Topics"];
  PD_Request_Customer_Portal_Change_Request_SAs_Found_Decision -> PD_Request_Customer_Portal_Change_Request_No_PD_to_schedule [label="otherwise"];
  PD_Request_Customer_Portal_Change_Request_SAs_Found_Decision -> PD_Request_Customer_Portal_Change_Request_Select_SAs_to_Edit [label="SAs Found"];
  PD_Request_Customer_Portal_Change_Request_Were_any_SAs_updated -> PD_Request_Customer_Portal_Change_Request_Go_back_to_update [label="otherwise"];
  PD_Request_Customer_Portal_Change_Request_Were_any_SAs_updated -> PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_Reactive_Collection [label="Yes, submitted SAs were modified"];
  PD_Request_Customer_Portal_Change_Request_Were_any_SAs_updated -> PD_Request_Customer_Portal_Change_Request_Thank_You_for_Submitting_Request [label="Scheduled SAs were updated"];
  PD_Request_Customer_Portal_Change_Request_Were_any_SAs_updated -> PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_Reactive_Collection [label="Requested and Scheduled SAs"];
  PD_Request_Customer_Portal_Change_Request_Were_any_sessions_selected -> PD_Request_Customer_Portal_Change_Request_None_Selected [label="otherwise"];
  PD_Request_Customer_Portal_Change_Request_Were_any_sessions_selected -> PD_Request_Customer_Portal_Change_Request_Make_Updates [label="Sessions Selected"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_PD_Session_Topics_to_create_Connector -> PD_Request_Customer_Portal_Change_Request_Loop_through_PD_Session_Topics_to_create_Connector [label="each", style="dashed"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_PD_Session_Topics_to_create_Connector -> PD_Request_Customer_Portal_Change_Request_Create_PDR_Session_Topic_Connector [label="done"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_Reactive_Collection -> PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_Reactive_Collection [label="each", style="dashed"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_Reactive_Collection -> PD_Request_Customer_Portal_Change_Request_SA_Screen_More_Info [label="done"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_to_create_PDR_SA_Connector -> PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_to_create_PDR_SA_Connector [label="each", style="dashed"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_to_create_PDR_SA_Connector -> PD_Request_Customer_Portal_Change_Request_Create_PDR_SA_Connector [label="done"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_Sorted_SAs -> PD_Request_Customer_Portal_Change_Request_Loop_through_Sorted_SAs [label="each", style="dashed"];
  PD_Request_Customer_Portal_Change_Request_Loop_through_Sorted_SAs -> PD_Request_Customer_Portal_Change_Request_Create_PD_Request [label="done"];
  PD_Request_Customer_Portal_Change_Request_Get_User_Details -> PD_Request_Customer_Portal_Change_Request_Get_User_s_Contact_Record [];
  PD_Request_Customer_Portal_Change_Request_Get_PD_Request_Record_Type -> PD_Request_Customer_Portal_Change_Request_Loop_through_Sorted_SAs [];
  PD_Request_Customer_Portal_Change_Request_Get_PD_Session_Topic_Records -> PD_Request_Customer_Portal_Change_Request_PD_Session_Topics_Found [];
  PD_Request_Customer_Portal_Change_Request_Get_Requested_SAs -> PD_Request_Customer_Portal_Change_Request_Get_scheduled_SAs [];
  PD_Request_Customer_Portal_Change_Request_Get_scheduled_SAs -> PD_Request_Customer_Portal_Change_Request_SAs_Found_Decision [];
  PD_Request_Customer_Portal_Change_Request_Get_User_s_Contact_Record -> PD_Request_Customer_Portal_Change_Request_Get_Requested_SAs [];
  PD_Request_Customer_Portal_Change_Request_Create_PD_Request -> PD_Request_Customer_Portal_Change_Request_Update_Reactive_SAs_Collection [];
  PD_Request_Customer_Portal_Change_Request_Create_PDR_SA_Connector -> PD_Request_Customer_Portal_Change_Request_Get_PD_Session_Topic_Records [];
  PD_Request_Customer_Portal_Change_Request_Create_PDR_Session_Topic_Connector -> PD_Request_Customer_Portal_Change_Request_Thank_You_Screen [];
  PD_Request_Customer_Portal_Change_Request_Update_Reactive_SAs_Collection -> PD_Request_Customer_Portal_Change_Request_Update_Toggle_Change_to_False_on_SAs [];
  PD_Request_Customer_Portal_Change_Request_Update_Toggle_Change_to_False_on_SAs -> PD_Request_Customer_Portal_Change_Request_Loop_through_SAs_to_create_PDR_SA_Connector [];
}