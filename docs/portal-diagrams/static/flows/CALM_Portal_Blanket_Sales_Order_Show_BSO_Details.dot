digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_start"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Blanket_Sales_Orders [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Blanket Sales Orders<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable, flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Blanket_Sales_Orders", penwidth="1.2"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_BSO_not_found [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>BSO not found<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_BSO_not_found", penwidth="2.6"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Were_any_BSOs_found [label=<Were any BSOs<BR/>found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Were_any_BSOs_found", penwidth="1.2"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Create_Order_Allocation_Request [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Create Order<BR/>Allocation Request>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Create_Order_Allocation_Request", penwidth="2.6"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_User_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_User_Details", penwidth="1.2"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_Blanket_Sales_Orders [label=<Get Blanket Sales Orders<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Blanket Sales Order (BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_Blanket_Sales_Orders", penwidth="1.2"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_CALM_Automation_Defaults [label=<Get CALM Automation<BR/>Defaults<BR/><FONT POINT-SIZE="8" COLOR="#555555">get CMDT: CALM Automation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Defaults</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_CALM_Automation_Defaults", penwidth="1.2"];
  start -> CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_User_Details;
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Blanket_Sales_Orders -> CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Create_Order_Allocation_Request [];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Were_any_BSOs_found -> CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Blanket_Sales_Orders [label="otherwise"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Were_any_BSOs_found -> CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_BSO_not_found [label="BSOs not found"];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_User_Details -> CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_CALM_Automation_Defaults [];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_Blanket_Sales_Orders -> CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Were_any_BSOs_found [];
  CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_CALM_Automation_Defaults -> CALM_Portal_Blanket_Sales_Order_Show_BSO_Details_Get_Blanket_Sales_Orders [];
