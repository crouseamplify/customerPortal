digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_Order_Allocation_Modal_start"];
  CALM_Portal_Order_Allocation_Modal_Delivery_Details_Confirmd [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Delivery Details Confirmd<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Order_Allocation_Modal_Delivery_Details_Confirmd", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Delivery_Instructions_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Delivery Instructions<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Order_Allocation_Modal_Delivery_Instructions_Screen", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_No_Order_Allocation [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>No Order Allocation<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Order_Allocation_Modal_No_Order_Allocation", penwidth="2.6"];
  CALM_Portal_Order_Allocation_Modal_phone_update_error [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>phone_update_error>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Order_Allocation_Modal_phone_update_error", penwidth="2.6"];
  CALM_Portal_Order_Allocation_Modal_Submitted_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Submitted Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Order_Allocation_Modal_Submitted_Details", penwidth="2.6"];
  CALM_Portal_Order_Allocation_Modal_Verify_Delivery_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Verify Delivery Details>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Order_Allocation_Modal_Verify_Delivery_Details", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Is_Order_Allocation_Confirmed [label=<Is Order<BR/>Allocation<BR/>Confirmed?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Order_Allocation_Modal_Is_Order_Allocation_Confirmed", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Required_Shipping_Fields_Missing [label=<Required Shipping<BR/>Fields Missing?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Order_Allocation_Modal_Required_Shipping_Fields_Missing", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Was_Order_Allocation_Found [label=<Was Order<BR/>Allocation Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Order_Allocation_Modal_Was_Order_Allocation_Found", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Edit_Shipping_Address [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Edit<BR/>Shipping Addresses>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Order_Allocation_Modal_Edit_Shipping_Address", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Get_User_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Order_Allocation_Modal_Get_User_Details", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Get_Account_Contacts [label=<Get Account Contacts<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Order_Allocation_Modal_Get_Account_Contacts", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Get_CALM_Automation_Defaults [label=<Get CALM Automation<BR/>Defaults<BR/><FONT POINT-SIZE="8" COLOR="#555555">get CMDT: CALM Automation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Defaults</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Order_Allocation_Modal_Get_CALM_Automation_Defaults", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Get_Order_Allocation [label=<Get Order Allocation<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation (site)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Order_Allocation_Modal_Get_Order_Allocation", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Get_Order_Allocation_Shipping_Address [label=<Get Order Allocation<BR/>Shipping Address<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Order_Allocation_Modal_Get_Order_Allocation_Shipping_Address", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Get_Primary_Ship_To_Contact [label=<Get Primary Ship To<BR/>Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Order_Allocation_Modal_Get_Primary_Ship_To_Contact", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Get_Selected_Shipping_Address_Record [label=<Get Selected Shipping<BR/>Address Record<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Order_Allocation_Modal_Get_Selected_Shipping_Address_Record", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Get_Shipping_Addresses [label=<Get Shipping Addresses<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Order_Allocation_Modal_Get_Shipping_Addresses", penwidth="1.2"];
  CALM_Portal_Order_Allocation_Modal_Update_Order_Allocation [label=<Update Order Allocation<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Order_Allocation_Modal_Update_Order_Allocation", penwidth="2.6"];
  CALM_Portal_Order_Allocation_Modal_Update_Ship_To_Contact_Phone_Number [label=<Update Ship To Contact<BR/>Phone Number<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Order_Allocation_Modal_Update_Ship_To_Contact_Phone_Number", penwidth="1.2"];
  start -> CALM_Portal_Order_Allocation_Modal_Get_CALM_Automation_Defaults;
  CALM_Portal_Order_Allocation_Modal_Delivery_Details_Confirmd -> CALM_Portal_Order_Allocation_Modal_Get_Shipping_Addresses [];
  CALM_Portal_Order_Allocation_Modal_Delivery_Instructions_Screen -> CALM_Portal_Order_Allocation_Modal_Get_Primary_Ship_To_Contact [];
  CALM_Portal_Order_Allocation_Modal_Verify_Delivery_Details -> CALM_Portal_Order_Allocation_Modal_Update_Order_Allocation [];
  CALM_Portal_Order_Allocation_Modal_Is_Order_Allocation_Confirmed -> CALM_Portal_Order_Allocation_Modal_Get_Shipping_Addresses [label="otherwise"];
  CALM_Portal_Order_Allocation_Modal_Is_Order_Allocation_Confirmed -> CALM_Portal_Order_Allocation_Modal_Submitted_Details [label="Submitted and Locked"];
  CALM_Portal_Order_Allocation_Modal_Is_Order_Allocation_Confirmed -> CALM_Portal_Order_Allocation_Modal_Delivery_Details_Confirmd [label="Confirmed"];
  CALM_Portal_Order_Allocation_Modal_Required_Shipping_Fields_Missing -> CALM_Portal_Order_Allocation_Modal_Verify_Delivery_Details [label="otherwise"];
  CALM_Portal_Order_Allocation_Modal_Required_Shipping_Fields_Missing -> CALM_Portal_Order_Allocation_Modal_Edit_Shipping_Address [label="Missing"];
  CALM_Portal_Order_Allocation_Modal_Was_Order_Allocation_Found -> CALM_Portal_Order_Allocation_Modal_Is_Order_Allocation_Confirmed [label="otherwise"];
  CALM_Portal_Order_Allocation_Modal_Was_Order_Allocation_Found -> CALM_Portal_Order_Allocation_Modal_No_Order_Allocation [label="No OA Found"];
  CALM_Portal_Order_Allocation_Modal_Edit_Shipping_Address -> CALM_Portal_Order_Allocation_Modal_Get_Selected_Shipping_Address_Record [];
  CALM_Portal_Order_Allocation_Modal_Get_User_Details -> CALM_Portal_Order_Allocation_Modal_Was_Order_Allocation_Found [];
  CALM_Portal_Order_Allocation_Modal_Get_Account_Contacts -> CALM_Portal_Order_Allocation_Modal_Delivery_Instructions_Screen [];
  CALM_Portal_Order_Allocation_Modal_Get_CALM_Automation_Defaults -> CALM_Portal_Order_Allocation_Modal_Get_Order_Allocation [];
  CALM_Portal_Order_Allocation_Modal_Get_Order_Allocation -> CALM_Portal_Order_Allocation_Modal_Get_User_Details [];
  CALM_Portal_Order_Allocation_Modal_Get_Order_Allocation_Shipping_Address -> CALM_Portal_Order_Allocation_Modal_Get_Account_Contacts [];
  CALM_Portal_Order_Allocation_Modal_Get_Primary_Ship_To_Contact -> CALM_Portal_Order_Allocation_Modal_Update_Ship_To_Contact_Phone_Number [];
  CALM_Portal_Order_Allocation_Modal_Get_Selected_Shipping_Address_Record -> CALM_Portal_Order_Allocation_Modal_Required_Shipping_Fields_Missing [];
  CALM_Portal_Order_Allocation_Modal_Get_Shipping_Addresses -> CALM_Portal_Order_Allocation_Modal_Get_Order_Allocation_Shipping_Address [];
  CALM_Portal_Order_Allocation_Modal_Update_Ship_To_Contact_Phone_Number -> CALM_Portal_Order_Allocation_Modal_Get_Selected_Shipping_Address_Record [];
}