digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="Customer_Portal_Create_Case_from_Webform_start"];
  Customer_Portal_Create_Case_from_Webform_Attach_Any_Files [label=<Attach Any Files?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Create_Case_from_Webform_Attach_Any_Files", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Search_Alternative_Contacts [label=<Search Alternative<BR/>Contacts>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Create_Case_from_Webform_Search_Alternative_Contacts", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Send_Email_With_or_Without_Template [label=<Send Email With or<BR/>Without Template?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Create_Case_from_Webform_Send_Email_With_or_Without_Template", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Was_Contact_Record_Found [label=<Was Contact Record<BR/>Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Create_Case_from_Webform_Was_Contact_Record_Found", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided [label=<Was Existing Case<BR/>Number Provided?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To [label=<Which Queue to<BR/>Assign Case To?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Add_Attachments_to_Case [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Add Attachments to Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">FileUploadImprovedHelper</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="Customer_Portal_Create_Case_from_Webform_Add_Attachments_to_Case", penwidth="2.6"];
  Customer_Portal_Create_Case_from_Webform_Add_Attachments_to_Email_Message [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Add Attachments to Email<BR/>Message<BR/><FONT POINT-SIZE="8" COLOR="#555555">FileUploadImprovedHelper</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="Customer_Portal_Create_Case_from_Webform_Add_Attachments_to_Email_Message", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Send_Email_Link_to_Case [label=<<FONT POINT-SIZE="8" COLOR="#555555">EMAIL</FONT><BR/>Send Email, Link to Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">emailSimple</FONT>>, shape="box", style="filled", fillcolor="#FCE4EC", color="#AD1457", class="n-email", id="Customer_Portal_Create_Case_from_Webform_Send_Email_Link_to_Case", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Send_Email_without_Template_Link_to_Case [label=<<FONT POINT-SIZE="8" COLOR="#555555">EMAIL</FONT><BR/>Send Email without<BR/>Template, Link to Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">emailSimple</FONT>>, shape="box", style="filled", fillcolor="#FCE4EC", color="#AD1457", class="n-email", id="Customer_Portal_Create_Case_from_Webform_Send_Email_without_Template_Link_to_Case", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Check_for_Matching_Contact [label=<Check for Matching Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Create_Case_from_Webform_Check_for_Matching_Contact", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Customer_Portal_Case_CMDT [label=<Customer Portal Case CMDT<BR/><FONT POINT-SIZE="8" COLOR="#555555">get CMDT: Portal Cases</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Create_Case_from_Webform_Customer_Portal_Case_CMDT", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Get_Email_Related_to_Case [label=<Get Email Related to Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Email Message</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Create_Case_from_Webform_Get_Email_Related_to_Case", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Get_New_Case_Number [label=<Get New Case Number<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Case</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Create_Case_from_Webform_Get_New_Case_Number", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Lookup_Existing_Case [label=<Lookup Existing Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Case</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Create_Case_from_Webform_Lookup_Existing_Case", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Search_for_Alternate_Contact [label=<Search for Alternate<BR/>Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Customer_Portal_Create_Case_from_Webform_Search_for_Alternate_Contact", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Add_Details_to_Case_Feed [label=<Add Details to Case Feed<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Event: Case Web Form</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Comment</FONT>>, shape="cylinder", style="filled", fillcolor="#F8BBD0", color="#880E4F", class="n-event", id="Customer_Portal_Create_Case_from_Webform_Add_Details_to_Case_Feed", penwidth="1.2"];
  Customer_Portal_Create_Case_from_Webform_Create_New_Case [label=<Create New Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Case</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="Customer_Portal_Create_Case_from_Webform_Create_New_Case", penwidth="1.2"];
  start -> Customer_Portal_Create_Case_from_Webform_Customer_Portal_Case_CMDT;
  Customer_Portal_Create_Case_from_Webform_Attach_Any_Files -> Customer_Portal_Create_Case_from_Webform_Add_Attachments_to_Email_Message [label="Has Attachments"];
  Customer_Portal_Create_Case_from_Webform_Search_Alternative_Contacts -> Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To [label="otherwise"];
  Customer_Portal_Create_Case_from_Webform_Search_Alternative_Contacts -> Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To [label="Alternate Contact Found"];
  Customer_Portal_Create_Case_from_Webform_Send_Email_With_or_Without_Template -> Customer_Portal_Create_Case_from_Webform_Send_Email_without_Template_Link_to_Case [label="otherwise"];
  Customer_Portal_Create_Case_from_Webform_Send_Email_With_or_Without_Template -> Customer_Portal_Create_Case_from_Webform_Send_Email_Link_to_Case [label="Email Contact Found"];
  Customer_Portal_Create_Case_from_Webform_Was_Contact_Record_Found -> Customer_Portal_Create_Case_from_Webform_Search_for_Alternate_Contact [label="otherwise"];
  Customer_Portal_Create_Case_from_Webform_Was_Contact_Record_Found -> Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To [label="Contact Found"];
  Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided -> Customer_Portal_Create_Case_from_Webform_Create_New_Case [label="otherwise"];
  Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided -> Customer_Portal_Create_Case_from_Webform_Lookup_Existing_Case [label="Provided Case Number"];
  Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To -> Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided [label="otherwise"];
  Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To -> Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided [label="Pedagogical Support"];
  Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To -> Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided [label="Physical Materials Support"];
  Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To -> Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided [label="Strategic Queue"];
  Customer_Portal_Create_Case_from_Webform_Which_Queue_to_Assign_Case_To -> Customer_Portal_Create_Case_from_Webform_Was_Existing_Case_Number_Provided [label="Digital Materials Support"];
  Customer_Portal_Create_Case_from_Webform_Add_Attachments_to_Email_Message -> Customer_Portal_Create_Case_from_Webform_Add_Attachments_to_Case [];
  Customer_Portal_Create_Case_from_Webform_Send_Email_Link_to_Case -> Customer_Portal_Create_Case_from_Webform_Get_Email_Related_to_Case [];
  Customer_Portal_Create_Case_from_Webform_Send_Email_without_Template_Link_to_Case -> Customer_Portal_Create_Case_from_Webform_Get_Email_Related_to_Case [];
  Customer_Portal_Create_Case_from_Webform_Check_for_Matching_Contact -> Customer_Portal_Create_Case_from_Webform_Was_Contact_Record_Found [];
  Customer_Portal_Create_Case_from_Webform_Customer_Portal_Case_CMDT -> Customer_Portal_Create_Case_from_Webform_Check_for_Matching_Contact [];
  Customer_Portal_Create_Case_from_Webform_Get_Email_Related_to_Case -> Customer_Portal_Create_Case_from_Webform_Attach_Any_Files [];
  Customer_Portal_Create_Case_from_Webform_Get_New_Case_Number -> Customer_Portal_Create_Case_from_Webform_Add_Details_to_Case_Feed [];
  Customer_Portal_Create_Case_from_Webform_Lookup_Existing_Case -> Customer_Portal_Create_Case_from_Webform_Create_New_Case [];
  Customer_Portal_Create_Case_from_Webform_Search_for_Alternate_Contact -> Customer_Portal_Create_Case_from_Webform_Search_Alternative_Contacts [];
  Customer_Portal_Create_Case_from_Webform_Add_Details_to_Case_Feed -> Customer_Portal_Create_Case_from_Webform_Send_Email_With_or_Without_Template [];
  Customer_Portal_Create_Case_from_Webform_Create_New_Case -> Customer_Portal_Create_Case_from_Webform_Get_New_Case_Number [];
}