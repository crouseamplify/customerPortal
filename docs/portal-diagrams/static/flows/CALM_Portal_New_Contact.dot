digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_New_Contact_start"];
  CALM_Portal_New_Contact_Affiliation_Blocked [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Affiliation Blocked>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_New_Contact_Affiliation_Blocked", penwidth="2.6"];
  CALM_Portal_New_Contact_Duplicate_Contact [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Duplicate Contact>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_New_Contact_Duplicate_Contact", penwidth="2.6"];
  CALM_Portal_New_Contact_New_Contact [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>New Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_New_Contact_New_Contact", penwidth="1.2"];
  CALM_Portal_New_Contact_new_success [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>new_success>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_New_Contact_new_success", penwidth="2.6"];
  CALM_Portal_New_Contact_Affiliation_Found [label=<Affiliation Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_New_Contact_Affiliation_Found", penwidth="1.2"];
  CALM_Portal_New_Contact_Check_Email_Account_Match [label=<Check Email<BR/>Account Match>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_New_Contact_Check_Email_Account_Match", penwidth="1.2"];
  CALM_Portal_New_Contact_Is_contact_a_duplicate [label=<Is contact a<BR/>duplicate?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_New_Contact_Is_contact_a_duplicate", penwidth="1.2"];
  CALM_Portal_New_Contact_Is_Contact_Only_Ship_To [label=<Requires Portal<BR/>Invite?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_New_Contact_Is_Contact_Only_Ship_To", penwidth="1.2"];
  CALM_Portal_New_Contact_Get_User_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_New_Contact_Get_User_Details", penwidth="1.2"];
  CALM_Portal_New_Contact_Check_for_Duplicate_Contact [label=<Check for Duplicate<BR/>Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_New_Contact_Check_for_Duplicate_Contact", penwidth="1.2"];
  CALM_Portal_New_Contact_Get_CALM_Automation_CMDT [label=<Get CALM Automation CMDT<BR/><FONT POINT-SIZE="8" COLOR="#555555">get CMDT: CALM Automation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Defaults</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_New_Contact_Get_CALM_Automation_CMDT", penwidth="1.2"];
  CALM_Portal_New_Contact_Get_Current_User_s_Contact [label=<Get Current User's Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_New_Contact_Get_Current_User_s_Contact", penwidth="1.2"];
  CALM_Portal_New_Contact_Get_existing_Affiliation [label=<Get existing Affiliation<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Affiliation</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_New_Contact_Get_existing_Affiliation", penwidth="1.2"];
  CALM_Portal_New_Contact_Get_Users_Account [label=<Get Users Account<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Account</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_New_Contact_Get_Users_Account", penwidth="1.2"];
  CALM_Portal_New_Contact_Create_Affiliation [label=<Create Affiliation<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Affiliation</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_New_Contact_Create_Affiliation", penwidth="1.2"];
  CALM_Portal_New_Contact_Create_New_Contact [label=<Create New Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_New_Contact_Create_New_Contact", penwidth="1.2"];
  CALM_Portal_New_Contact_Update_Affiliation [label=<Update Affiliation<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Affiliation</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_New_Contact_Update_Affiliation", penwidth="1.2"];
  start -> CALM_Portal_New_Contact_Get_User_Details;
  CALM_Portal_New_Contact_New_Contact -> CALM_Portal_New_Contact_Is_Contact_Only_Ship_To [];
  CALM_Portal_New_Contact_Affiliation_Found -> CALM_Portal_New_Contact_Create_Affiliation [label="otherwise"];
  CALM_Portal_New_Contact_Affiliation_Found -> CALM_Portal_New_Contact_Update_Affiliation [label="Yes Former Affiliation"];
  CALM_Portal_New_Contact_Affiliation_Found -> CALM_Portal_New_Contact_Duplicate_Contact [label="Yes"];
  CALM_Portal_New_Contact_Check_Email_Account_Match -> CALM_Portal_New_Contact_Affiliation_Blocked [label="otherwise"];
  CALM_Portal_New_Contact_Check_Email_Account_Match -> CALM_Portal_New_Contact_Get_existing_Affiliation [label="Match to User Acct Reasonable"];
  CALM_Portal_New_Contact_Is_contact_a_duplicate -> CALM_Portal_New_Contact_Create_New_Contact [label="otherwise"];
  CALM_Portal_New_Contact_Is_contact_a_duplicate -> CALM_Portal_New_Contact_Get_Users_Account [label="Duplicate"];
  CALM_Portal_New_Contact_Is_Contact_Only_Ship_To -> CALM_Portal_New_Contact_Check_for_Duplicate_Contact [label="otherwise"];
  CALM_Portal_New_Contact_Is_Contact_Only_Ship_To -> CALM_Portal_New_Contact_Check_for_Duplicate_Contact [label="No Portal Invite"];
  CALM_Portal_New_Contact_Get_User_Details -> CALM_Portal_New_Contact_Get_Current_User_s_Contact [];
  CALM_Portal_New_Contact_Check_for_Duplicate_Contact -> CALM_Portal_New_Contact_Is_contact_a_duplicate [];
  CALM_Portal_New_Contact_Get_CALM_Automation_CMDT -> CALM_Portal_New_Contact_New_Contact [];
  CALM_Portal_New_Contact_Get_Current_User_s_Contact -> CALM_Portal_New_Contact_Get_CALM_Automation_CMDT [];
  CALM_Portal_New_Contact_Get_existing_Affiliation -> CALM_Portal_New_Contact_Affiliation_Found [];
  CALM_Portal_New_Contact_Get_Users_Account -> CALM_Portal_New_Contact_Check_Email_Account_Match [];
  CALM_Portal_New_Contact_Create_Affiliation -> CALM_Portal_New_Contact_Duplicate_Contact [];
  CALM_Portal_New_Contact_Create_New_Contact -> CALM_Portal_New_Contact_new_success [];
  CALM_Portal_New_Contact_Update_Affiliation -> CALM_Portal_New_Contact_Duplicate_Contact [];
}