digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_Edit_Shipping_Addresses_start"];
  CALM_Portal_Edit_Shipping_Addresses_Edit_Shipping_Addresses [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Edit Shipping Addresses<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker, fsc_drawLine</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Edit_Shipping_Addresses_Edit_Shipping_Addresses", penwidth="1.2"];
  CALM_Portal_Edit_Shipping_Addresses_New_Shipping_Address [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>New Shipping Address>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Edit_Shipping_Addresses_New_Shipping_Address", penwidth="1.2"];
  CALM_Portal_Edit_Shipping_Addresses_Is_Shipping_Address_Used_On_Any_Order_Allocations [label=<Is Shipping<BR/>Address Used On<BR/>Any Order<BR/>Allocations?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Edit_Shipping_Addresses_Is_Shipping_Address_Used_On_Any_Order_Allocations", penwidth="1.2"];
  CALM_Portal_Edit_Shipping_Addresses_Check_For_Order_Allocations_Using_Address [label=<Check For Order<BR/>Allocations Using Address<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation (site)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Edit_Shipping_Addresses_Check_For_Order_Allocations_Using_Address", penwidth="1.2"];
  CALM_Portal_Edit_Shipping_Addresses_Getting_Shipping_Address [label=<Getting Shipping Address<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Edit_Shipping_Addresses_Getting_Shipping_Address", penwidth="1.2"];
  CALM_Portal_Edit_Shipping_Addresses_Create_Shipping_Address_Clone [label=<Create Shipping Address<BR/>Clone<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Shipping Address *</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Edit_Shipping_Addresses_Create_Shipping_Address_Clone", penwidth="1.2"];
  CALM_Portal_Edit_Shipping_Addresses_Add_New_Shipping_Address_to_Old_Shipping_Address_Lookup [label=<Add New Shipping Address<BR/>to Old Shipping Address<BR/>Lookup<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Edit_Shipping_Addresses_Add_New_Shipping_Address_to_Old_Shipping_Address_Lookup", penwidth="1.2"];
  CALM_Portal_Edit_Shipping_Addresses_Update_Order_Allocation_Status_and_Shipping_Address [label=<Update Order Allocation<BR/>Status and Shipping<BR/>Address<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site) *</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Edit_Shipping_Addresses_Update_Order_Allocation_Status_and_Shipping_Address", penwidth="2.6"];
  CALM_Portal_Edit_Shipping_Addresses_Update_Shipping_Address_Details [label=<Update Shipping Address<BR/>Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Edit_Shipping_Addresses_Update_Shipping_Address_Details", penwidth="2.6"];
  start -> CALM_Portal_Edit_Shipping_Addresses_Getting_Shipping_Address;
  CALM_Portal_Edit_Shipping_Addresses_Edit_Shipping_Addresses -> CALM_Portal_Edit_Shipping_Addresses_Is_Shipping_Address_Used_On_Any_Order_Allocations [];
  CALM_Portal_Edit_Shipping_Addresses_New_Shipping_Address -> CALM_Portal_Edit_Shipping_Addresses_Create_Shipping_Address_Clone [];
