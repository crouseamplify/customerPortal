digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="Knowledge_Article_Feedback_Customer_Portal_start"];
  Knowledge_Article_Feedback_Customer_Portal_Blank_Collection [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Blank Collection>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Knowledge_Article_Feedback_Customer_Portal_Blank_Collection", penwidth="2.6"];
  Knowledge_Article_Feedback_Customer_Portal_Hide_Voting [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Hide Voting<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Knowledge_Article_Feedback_Customer_Portal_Hide_Voting", penwidth="2.6"];
  Knowledge_Article_Feedback_Customer_Portal_thank_you_screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>thank_you_screen>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Knowledge_Article_Feedback_Customer_Portal_thank_you_screen", penwidth="2.6"];
  Knowledge_Article_Feedback_Customer_Portal_Vote_Reasoning [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Vote Reasoning>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Knowledge_Article_Feedback_Customer_Portal_Vote_Reasoning", penwidth="1.2"];
  Knowledge_Article_Feedback_Customer_Portal_Voting [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Voting<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Knowledge_Article_Feedback_Customer_Portal_Voting", penwidth="1.2"];
  Knowledge_Article_Feedback_Customer_Portal_Failed_to_find_article [label=<Failed to find<BR/>article>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Knowledge_Article_Feedback_Customer_Portal_Failed_to_find_article", penwidth="1.2"];
  Knowledge_Article_Feedback_Customer_Portal_Yes_or_No [label=<Yes or No?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Knowledge_Article_Feedback_Customer_Portal_Yes_or_No", penwidth="1.2"];
  Knowledge_Article_Feedback_Customer_Portal_Get_Knowledge_Article [label=<Get Knowledge Article<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Knowledge Article</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Knowledge_Article_Feedback_Customer_Portal_Get_Knowledge_Article", penwidth="1.2"];
  Knowledge_Article_Feedback_Customer_Portal_Create_Article_Feedback_Record [label=<Create Article Feedback<BR/>Record<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Article Feedback</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="Knowledge_Article_Feedback_Customer_Portal_Create_Article_Feedback_Record", penwidth="1.2"];
  start -> Knowledge_Article_Feedback_Customer_Portal_Get_Knowledge_Article;
  Knowledge_Article_Feedback_Customer_Portal_Vote_Reasoning -> Knowledge_Article_Feedback_Customer_Portal_Create_Article_Feedback_Record [];
  Knowledge_Article_Feedback_Customer_Portal_Voting -> Knowledge_Article_Feedback_Customer_Portal_Yes_or_No [];
  Knowledge_Article_Feedback_Customer_Portal_Failed_to_find_article -> Knowledge_Article_Feedback_Customer_Portal_Hide_Voting [label="otherwise"];
  Knowledge_Article_Feedback_Customer_Portal_Failed_to_find_article -> Knowledge_Article_Feedback_Customer_Portal_Blank_Collection [label="Article is Collection"];
  Knowledge_Article_Feedback_Customer_Portal_Failed_to_find_article -> Knowledge_Article_Feedback_Customer_Portal_Voting [label="Article Found"];
  Knowledge_Article_Feedback_Customer_Portal_Failed_to_find_article -> Knowledge_Article_Feedback_Customer_Portal_Hide_Voting [label="Article Not Published"];
  Knowledge_Article_Feedback_Customer_Portal_Yes_or_No -> Knowledge_Article_Feedback_Customer_Portal_Vote_Reasoning [label="otherwise"];
  Knowledge_Article_Feedback_Customer_Portal_Yes_or_No -> Knowledge_Article_Feedback_Customer_Portal_Create_Article_Feedback_Record [label="Yes Choice"];
  Knowledge_Article_Feedback_Customer_Portal_Get_Knowledge_Article -> Knowledge_Article_Feedback_Customer_Portal_Failed_to_find_article [];
  Knowledge_Article_Feedback_Customer_Portal_Create_Article_Feedback_Record -> Knowledge_Article_Feedback_Customer_Portal_thank_you_screen [];
}