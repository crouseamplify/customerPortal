digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_Get_User_Details_start"];
  CALM_Portal_Get_User_Details_Child_Accounts_Found [label=<Child Accounts<BR/>Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Get_User_Details_Child_Accounts_Found", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Is_Flow_Triggered_by_Internal_User [label=<Is Flow Triggered<BR/>by Internal User?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Get_User_Details_Is_Flow_Triggered_by_Internal_User", penwidth="1.2"];
  CALM_Portal_Get_User_Details_User_Affiliations_Found [label=<User Affiliations<BR/>Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Get_User_Details_User_Affiliations_Found", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Was_an_Affiliation_Record_Found [label=<Was an Affiliation<BR/>Record Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Get_User_Details_Was_an_Affiliation_Record_Found", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Extract_Contact_Ids_from_Affiliations [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Extract Contact Ids from<BR/>Affiliations<BR/><FONT POINT-SIZE="8" COLOR="#555555">ExtractStringsFromCollection</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="CALM_Portal_Get_User_Details_Extract_Contact_Ids_from_Affiliations", penwidth="2.6"];
  CALM_Portal_Get_User_Details_Extract_Ids_from_Accounts [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Extract Ids from Accounts<BR/><FONT POINT-SIZE="8" COLOR="#555555">ExtractStringsFromCollection</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="CALM_Portal_Get_User_Details_Extract_Ids_from_Accounts", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Get_Allowed_Accounts_from_Affiliations [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Get Allowed Accounts from<BR/>Affiliations<BR/><FONT POINT-SIZE="8" COLOR="#555555">ExtractStringsFromCollection</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="CALM_Portal_Get_User_Details_Get_Allowed_Accounts_from_Affiliations", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Get_Affiliation_Records [label=<Get Affiliation Records<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Affiliation</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Get_User_Details_Get_Affiliation_Records", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Get_BSO_Primary_Contact [label=<Get BSO Primary Contact<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Get_User_Details_Get_BSO_Primary_Contact", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Get_Child_Accounts [label=<Get Child Accounts<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Account</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Get_User_Details_Get_Child_Accounts", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Get_Contact_Record_for_Portal_User [label=<Get Contact Record for<BR/>Portal User<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Contact</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Get_User_Details_Get_Contact_Record_for_Portal_User", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Get_Portal_User [label=<Get Portal User<BR/><FONT POINT-SIZE="8" COLOR="#555555">get User</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Get_User_Details_Get_Portal_User", penwidth="1.2"];
  CALM_Portal_Get_User_Details_Get_Users_Affiliations [label=<Get Users Affiliations<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Affiliation</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Get_User_Details_Get_Users_Affiliations", penwidth="1.2"];
  start -> CALM_Portal_Get_User_Details_Is_Flow_Triggered_by_Internal_User;
  CALM_Portal_Get_User_Details_Child_Accounts_Found -> CALM_Portal_Get_User_Details_Get_Users_Affiliations [label="otherwise"];
  CALM_Portal_Get_User_Details_Child_Accounts_Found -> CALM_Portal_Get_User_Details_Extract_Ids_from_Accounts [label="Yes, Has Child Accounts"];
  CALM_Portal_Get_User_Details_Is_Flow_Triggered_by_Internal_User -> CALM_Portal_Get_User_Details_Get_Portal_User [label="otherwise"];
  CALM_Portal_Get_User_Details_Is_Flow_Triggered_by_Internal_User -> CALM_Portal_Get_User_Details_Get_BSO_Primary_Contact [label="Internal User"];
  CALM_Portal_Get_User_Details_User_Affiliations_Found -> CALM_Portal_Get_User_Details_Get_Affiliation_Records [label="otherwise"];
  CALM_Portal_Get_User_Details_User_Affiliations_Found -> CALM_Portal_Get_User_Details_Get_Allowed_Accounts_from_Affiliations [label="Yes, Has Secondary Affiliations"];
  CALM_Portal_Get_User_Details_Was_an_Affiliation_Record_Found -> CALM_Portal_Get_User_Details_Extract_Contact_Ids_from_Affiliations [label="otherwise"];
  CALM_Portal_Get_User_Details_Extract_Ids_from_Accounts -> CALM_Portal_Get_User_Details_Get_Users_Affiliations [];
  CALM_Portal_Get_User_Details_Get_Allowed_Accounts_from_Affiliations -> CALM_Portal_Get_User_Details_Get_Affiliation_Records [];
  CALM_Portal_Get_User_Details_Get_Affiliation_Records -> CALM_Portal_Get_User_Details_Was_an_Affiliation_Record_Found [];
  CALM_Portal_Get_User_Details_Get_BSO_Primary_Contact -> CALM_Portal_Get_User_Details_Get_Child_Accounts [];
  CALM_Portal_Get_User_Details_Get_Child_Accounts -> CALM_Portal_Get_User_Details_Child_Accounts_Found [];
  CALM_Portal_Get_User_Details_Get_Contact_Record_for_Portal_User -> CALM_Portal_Get_User_Details_Get_Child_Accounts [];
  CALM_Portal_Get_User_Details_Get_Portal_User -> CALM_Portal_Get_User_Details_Get_Contact_Record_for_Portal_User [];
  CALM_Portal_Get_User_Details_Get_Users_Affiliations -> CALM_Portal_Get_User_Details_User_Affiliations_Found [];
}