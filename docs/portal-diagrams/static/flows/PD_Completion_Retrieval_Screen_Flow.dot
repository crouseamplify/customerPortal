digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="PD_Completion_Retrieval_Screen_Flow_start"];
  PD_Completion_Retrieval_Screen_Flow_Browser_Side_Compare [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Browser Side Compare<BR/><FONT POINT-SIZE="8" COLOR="#555555">bcryptLWC</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_Retrieval_Screen_Flow_Browser_Side_Compare", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_Retrieval_Screen_Flow_Details", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Download_PDF [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Download PDF<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker, jsPDFDocGen</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_Retrieval_Screen_Flow_Download_PDF", penwidth="2.6"];
  PD_Completion_Retrieval_Screen_Flow_No_PDs_Found [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>No PDs Found<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_Retrieval_Screen_Flow_No_PDs_Found", penwidth="2.6"];
  PD_Completion_Retrieval_Screen_Flow_PII_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>PII Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_Retrieval_Screen_Flow_PII_Details", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Show_Certificates [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Show Certificates<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable, flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Completion_Retrieval_Screen_Flow_Show_Certificates", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Any_Matching_PDs_Found [label=<Any Matching PDs<BR/>Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Completion_Retrieval_Screen_Flow_Any_Matching_PDs_Found", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Found_PD_Completion [label=<Found PD<BR/>Completion?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Completion_Retrieval_Screen_Flow_Found_PD_Completion", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Loop_Completion_Records [label=<Loop Completion<BR/>Records>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="PD_Completion_Retrieval_Screen_Flow_Loop_Completion_Records", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Loop [label=<<FONT POINT-SIZE="8" COLOR="#555555">LOOP</FONT><BR/>Loop>, shape="box", style="rounded,filled,dashed", fillcolor="#E8EAF6", color="#3949AB", class="n-loop", id="PD_Completion_Retrieval_Screen_Flow_Loop", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Generate_SHA256_Hash [label=<<FONT POINT-SIZE="8" COLOR="#555555">ACTION</FONT><BR/>Generate SHA256 Hash<BR/><FONT POINT-SIZE="8" COLOR="#555555">securehash__CryptoHashGenerator</FONT>>, shape="box", style="filled", fillcolor="#ECEFF1", color="#546E7A", class="n-action", id="PD_Completion_Retrieval_Screen_Flow_Generate_SHA256_Hash", penwidth="1.2"];
  PD_Completion_Retrieval_Screen_Flow_Get_PD_Completion_Records [label=<Get PD Completion Records<BR/><FONT POINT-SIZE="8" COLOR="#555555">get PD Completion</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="PD_Completion_Retrieval_Screen_Flow_Get_PD_Completion_Records", penwidth="1.2"];
  start -> PD_Completion_Retrieval_Screen_Flow_Details;
  PD_Completion_Retrieval_Screen_Flow_Browser_Side_Compare -> PD_Completion_Retrieval_Screen_Flow_Loop_Completion_Records [];
  PD_Completion_Retrieval_Screen_Flow_Details -> PD_Completion_Retrieval_Screen_Flow_Get_PD_Completion_Records [];
  PD_Completion_Retrieval_Screen_Flow_PII_Details -> PD_Completion_Retrieval_Screen_Flow_Loop [];
  PD_Completion_Retrieval_Screen_Flow_Show_Certificates -> PD_Completion_Retrieval_Screen_Flow_Download_PDF [];
  PD_Completion_Retrieval_Screen_Flow_Any_Matching_PDs_Found -> PD_Completion_Retrieval_Screen_Flow_Show_Certificates [label="otherwise"];
  PD_Completion_Retrieval_Screen_Flow_Any_Matching_PDs_Found -> PD_Completion_Retrieval_Screen_Flow_No_PDs_Found [label="No Matching PDs"];
  PD_Completion_Retrieval_Screen_Flow_Found_PD_Completion -> PD_Completion_Retrieval_Screen_Flow_PII_Details [label="otherwise"];
  PD_Completion_Retrieval_Screen_Flow_Found_PD_Completion -> PD_Completion_Retrieval_Screen_Flow_No_PDs_Found [label="No records found"];
  PD_Completion_Retrieval_Screen_Flow_Loop_Completion_Records -> PD_Completion_Retrieval_Screen_Flow_Loop [label="otherwise"];
  PD_Completion_Retrieval_Screen_Flow_Loop_Completion_Records -> PD_Completion_Retrieval_Screen_Flow_Loop [label="Match"];
  PD_Completion_Retrieval_Screen_Flow_Loop -> PD_Completion_Retrieval_Screen_Flow_Generate_SHA256_Hash [label="each", style="dashed"];
  PD_Completion_Retrieval_Screen_Flow_Loop -> PD_Completion_Retrieval_Screen_Flow_Any_Matching_PDs_Found [label="done"];
  PD_Completion_Retrieval_Screen_Flow_Generate_SHA256_Hash -> PD_Completion_Retrieval_Screen_Flow_Browser_Side_Compare [];
  PD_Completion_Retrieval_Screen_Flow_Get_PD_Completion_Records -> PD_Completion_Retrieval_Screen_Flow_Found_PD_Completion [];
}