digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Portal_Add_New_Shipping_Addresses_start"];
  CALM_Portal_Add_New_Shipping_Addresses_Add_Shipping_Addresses [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Add Shipping Addresses<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Add_New_Shipping_Addresses_Add_Shipping_Addresses", penwidth="1.2"];
  CALM_Portal_Add_New_Shipping_Addresses_Thank_You_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Thank You Screen>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Portal_Add_New_Shipping_Addresses_Thank_You_Screen", penwidth="2.6"];
  CALM_Portal_Add_New_Shipping_Addresses_Was_Flow_Triggered_by_Internal_User [label=<Was Flow Triggered<BR/>by Internal User?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Portal_Add_New_Shipping_Addresses_Was_Flow_Triggered_by_Internal_User", penwidth="1.2"];
  CALM_Portal_Add_New_Shipping_Addresses_Get_User_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Portal_Add_New_Shipping_Addresses_Get_User_Details", penwidth="1.2"];
  CALM_Portal_Add_New_Shipping_Addresses_Get_BSO_Details [label=<Get BSO Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Blanket Sales Order (BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Portal_Add_New_Shipping_Addresses_Get_BSO_Details", penwidth="1.2"];
  CALM_Portal_Add_New_Shipping_Addresses_Create_New_Shipping_Address [label=<Create New Shipping<BR/>Address<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Portal_Add_New_Shipping_Addresses_Create_New_Shipping_Address", penwidth="1.2"];
  start -> CALM_Portal_Add_New_Shipping_Addresses_Was_Flow_Triggered_by_Internal_User;
  CALM_Portal_Add_New_Shipping_Addresses_Add_Shipping_Addresses -> CALM_Portal_Add_New_Shipping_Addresses_Create_New_Shipping_Address [];
  CALM_Portal_Add_New_Shipping_Addresses_Was_Flow_Triggered_by_Internal_User -> CALM_Portal_Add_New_Shipping_Addresses_Get_User_Details [label="otherwise"];
  CALM_Portal_Add_New_Shipping_Addresses_Was_Flow_Triggered_by_Internal_User -> CALM_Portal_Add_New_Shipping_Addresses_Get_BSO_Details [label="Internal Trigger"];
  CALM_Portal_Add_New_Shipping_Addresses_Get_User_Details -> CALM_Portal_Add_New_Shipping_Addresses_Add_Shipping_Addresses [];
  CALM_Portal_Add_New_Shipping_Addresses_Get_BSO_Details -> CALM_Portal_Add_New_Shipping_Addresses_Add_Shipping_Addresses [];
  CALM_Portal_Add_New_Shipping_Addresses_Create_New_Shipping_Address -> CALM_Portal_Add_New_Shipping_Addresses_Thank_You_Screen [];
}