digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="CALM_Create_Order_Allocation_start"];
  CALM_Create_Order_Allocation_No_OAR_Found [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>No OAR Found<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">flowAutoNavigate</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Create_Order_Allocation_No_OAR_Found", penwidth="1.2"];
  CALM_Create_Order_Allocation_Order_Allocation_Requests [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Order Allocation Requests<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable, flowPortalTracker,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">fsc_flowButtonBar</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="CALM_Create_Order_Allocation_Order_Allocation_Requests", penwidth="1.2"];
  CALM_Create_Order_Allocation_Order_Allocation_Requests_Exist [label=<Order Allocation<BR/>Requests Exist?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Create_Order_Allocation_Order_Allocation_Requests_Exist", penwidth="1.2"];
  CALM_Create_Order_Allocation_Viewed_by_Internal_User [label=<Viewed by Internal<BR/>User?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Create_Order_Allocation_Viewed_by_Internal_User", penwidth="1.2"];
  CALM_Create_Order_Allocation_Where_to_navigate [label=<Where to navigate?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="CALM_Create_Order_Allocation_Where_to_navigate", penwidth="1.2"];
  CALM_Create_Order_Allocation_Edit_Order_Allocation [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Edit Order<BR/>Allocations>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="CALM_Create_Order_Allocation_Edit_Order_Allocation", penwidth="2.6"];
  CALM_Create_Order_Allocation_Get_Blanket_Sales_Order [label=<Get Blanket Sales Order<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Blanket Sales Order (BSO)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Create_Order_Allocation_Get_Blanket_Sales_Order", penwidth="1.2"];
  CALM_Create_Order_Allocation_Get_Order_Allocation_Requests [label=<Get Order Allocation<BR/>Requests<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation Request</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Create_Order_Allocation_Get_Order_Allocation_Requests", penwidth="1.2"];
  CALM_Create_Order_Allocation_Order_Allocation_Request [label=<Order Allocation Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Order Allocation Request</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="CALM_Create_Order_Allocation_Order_Allocation_Request", penwidth="1.2"];
  CALM_Create_Order_Allocation_Create_Order_Allocation [label=<Create Order Allocation<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(site)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Create_Order_Allocation_Create_Order_Allocation", penwidth="1.2"];
  CALM_Create_Order_Allocation_New_Order_Allocation_Request [label=<New Order Allocation<BR/>Request<BR/><FONT POINT-SIZE="8" COLOR="#555555">create Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Request (OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Create_Order_Allocation_New_Order_Allocation_Request", penwidth="1.2"];
  CALM_Create_Order_Allocation_Update_OAR_Record_View_Counter [label=<Update OAR Record View<BR/>Counter<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Request (OAR)</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="CALM_Create_Order_Allocation_Update_OAR_Record_View_Counter", penwidth="1.2"];
  start -> CALM_Create_Order_Allocation_Get_Blanket_Sales_Order;
  CALM_Create_Order_Allocation_No_OAR_Found -> CALM_Create_Order_Allocation_New_Order_Allocation_Request [];
  CALM_Create_Order_Allocation_Order_Allocation_Requests -> CALM_Create_Order_Allocation_Where_to_navigate [];
  CALM_Create_Order_Allocation_Order_Allocation_Requests_Exist -> CALM_Create_Order_Allocation_No_OAR_Found [label="otherwise"];
  CALM_Create_Order_Allocation_Order_Allocation_Requests_Exist -> CALM_Create_Order_Allocation_Order_Allocation_Requests [label="Yes, Existing Order Allocation Requests"];
  CALM_Create_Order_Allocation_Viewed_by_Internal_User -> CALM_Create_Order_Allocation_Update_OAR_Record_View_Counter [label="otherwise"];
  CALM_Create_Order_Allocation_Viewed_by_Internal_User -> CALM_Create_Order_Allocation_Edit_Order_Allocation [label="Internal"];
  CALM_Create_Order_Allocation_Where_to_navigate -> CALM_Create_Order_Allocation_Viewed_by_Internal_User [label="otherwise"];
  CALM_Create_Order_Allocation_Where_to_navigate -> CALM_Create_Order_Allocation_New_Order_Allocation_Request [label="Start a new request"];
  CALM_Create_Order_Allocation_Get_Blanket_Sales_Order -> CALM_Create_Order_Allocation_Get_Order_Allocation_Requests [];
  CALM_Create_Order_Allocation_Get_Order_Allocation_Requests -> CALM_Create_Order_Allocation_Order_Allocation_Requests_Exist [];
  CALM_Create_Order_Allocation_Order_Allocation_Request -> CALM_Create_Order_Allocation_Create_Order_Allocation [];
  CALM_Create_Order_Allocation_Create_Order_Allocation -> CALM_Create_Order_Allocation_Viewed_by_Internal_User [];
  CALM_Create_Order_Allocation_New_Order_Allocation_Request -> CALM_Create_Order_Allocation_Order_Allocation_Request [];
  CALM_Create_Order_Allocation_Update_OAR_Record_View_Counter -> CALM_Create_Order_Allocation_Edit_Order_Allocation [];
}