  PD_Request_New_Customer_Portal_Input_Reactive_Screen_for_SA_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Reactive Screen for SA<BR/>Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">reactiveRecordCollection_rsc,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">upsertRecordByKey_rsc,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">dynamicFlowProgressLWC,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">flowLauncherSObject</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_New_Customer_Portal_Input_Reactive_Screen_for_SA_Details", penwidth="1.2"];
  PD_Request_New_Customer_Portal_Input_Screen_to_Pick_SAs [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Screen to Pick SAs<BR/><FONT POINT-SIZE="8" COLOR="#555555">datatable,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">dynamicFlowProgressLWC</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_New_Customer_Portal_Input_Screen_to_Pick_SAs", penwidth="1.2"];
  PD_Request_New_Customer_Portal_Input_Thank_You [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Thank You>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="PD_Request_New_Customer_Portal_Input_Thank_You", penwidth="2.6"];
