digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_start"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Case_Submitted [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Case Submitted>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Case_Submitted", penwidth="2.6"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Confirmation [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Confirmation>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Confirmation", penwidth="2.6"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Key_Dates [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Manage TO Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Key_Dates", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_No_TO_Case [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>No TO Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_No_TO_Case", penwidth="2.6"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Review_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Review Details>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Review_Details", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Select_TO_Case [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Select TO Case>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Select_TO_Case", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Is_Digital_Onboarding_Case_New [label=<Is Digital<BR/>Onboarding Case<BR/>New?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Is_Digital_Onboarding_Case_New", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Automation_Defaults_Retrieved [label=<Was Customer<BR/>Portal CMDT<BR/>Retrieved?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Automation_Defaults_Retrieved", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Cases_Found [label=<Were Cases Found?>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Cases_Found", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Fault_Path_Screen_Flow_and_Logging [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>Customer Portal | Fault<BR/>Path Screen>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Fault_Path_Screen_Flow_and_Logging", penwidth="2.6"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Current_User_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>CALM Portal | Get User<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Current_User_Details", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Customer_Portal_Default_Automation [label=<Get Customer Portal<BR/>Default Automation<BR/><FONT POINT-SIZE="8" COLOR="#555555">get CMDT: Portal Automation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Default</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Customer_Portal_Default_Automation", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Technical_Onboarding_Cases [label=<Get Technical Onboarding<BR/>Cases<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Case</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Technical_Onboarding_Cases", penwidth="1.2"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Update_Technical_Onboarding_Case [label=<Update Technical<BR/>Onboarding Case<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Case</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Update_Technical_Onboarding_Case", penwidth="1.2"];
  start -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Current_User_Details;
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Key_Dates -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Review_Details [];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Review_Details -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Update_Technical_Onboarding_Case [];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Select_TO_Case -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Is_Digital_Onboarding_Case_New [];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Is_Digital_Onboarding_Case_New -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Key_Dates [label="otherwise"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Is_Digital_Onboarding_Case_New -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Case_Submitted [label="Submitted/Updated"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Automation_Defaults_Retrieved -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Fault_Path_Screen_Flow_and_Logging [label="otherwise"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Automation_Defaults_Retrieved -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Technical_Onboarding_Cases [label="CMDT Retrieved"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Cases_Found -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_No_TO_Case [label="otherwise"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Cases_Found -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Select_TO_Case [label="Cases Found"];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Current_User_Details -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Customer_Portal_Default_Automation [];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Customer_Portal_Default_Automation -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Automation_Defaults_Retrieved [];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Get_Technical_Onboarding_Cases -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Were_Cases_Found [];
  Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Update_Technical_Onboarding_Case -> Digital_Onboarding_Page_Key_Dates_and_Rostering_Information_Confirmation [];
}