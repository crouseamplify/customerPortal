digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];

  start [label="Start", shape=circle, style=filled, fillcolor="#37474F", fontcolor="white", color="#37474F", width=0.5, fixedsize=true, id="Tutor_School_Request_Screen_start"];
  Tutor_School_Request_Screen_Approval_Confirmation [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Approval Confirmation from<BR/>Screen>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Tutor_School_Request_Screen_Approval_Confirmation", penwidth="2.6"];
  Tutor_School_Request_Screen_Copy_1_of_Approval_Confirmation [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>Approval Confirmation from<BR/>Record<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Tutor_School_Request_Screen_Copy_1_of_Approval_Confirmation", penwidth="2.6"];
  Tutor_School_Request_Screen_saveReminder [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>saveReminder>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Tutor_School_Request_Screen_saveReminder", penwidth="2.6"];
  Tutor_School_Request_Screen_School_Approval_Screen [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>School Approval Screen<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Tutor_School_Request_Screen_School_Approval_Screen", penwidth="1.2"];
  Tutor_School_Request_Screen_School_Information [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>School Information<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Tutor_School_Request_Screen_School_Information", penwidth="1.2"];
  Tutor_School_Request_Screen_School_Submission_Confirmation_from_saved_school_record [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>School Submission<BR/>Confirmation (from saved<BR/>school record)<BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker</FONT>>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Tutor_School_Request_Screen_School_Submission_Confirmation_from_saved_school_record", penwidth="2.6"];
  Tutor_School_Request_Screen_School_Submission_Confirmation_from_screen_input [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN</FONT><BR/>School Submission<BR/>Confirmation (from screen<BR/>input)>, shape="box", style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0", class="n-screen", id="Tutor_School_Request_Screen_School_Submission_Confirmation_from_screen_input", penwidth="2.6"];
  Tutor_School_Request_Screen_Check_Form_Complete_Checkbox [label=<Check Form<BR/>Complete Checkbox>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Tutor_School_Request_Screen_Check_Form_Complete_Checkbox", penwidth="1.2"];
  Tutor_School_Request_Screen_Check_if_Approval_Submitted [label=<Check if Approval<BR/>Submitted>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Tutor_School_Request_Screen_Check_if_Approval_Submitted", penwidth="1.2"];
  Tutor_School_Request_Screen_Check_if_School_Schedule_Request_Complete [label=<Check if School<BR/>Schedule Request<BR/>Complete>, shape="diamond", style="filled", fillcolor="#FFF8E1", color="#F9A825", class="n-decision", id="Tutor_School_Request_Screen_Check_if_School_Schedule_Request_Complete", penwidth="1.2"];
  Tutor_School_Request_Screen_Fault_Path [label=<<FONT POINT-SIZE="8" COLOR="#555555">SUBFLOW</FONT><BR/>Customer Portal | Fault<BR/>Path Screen>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="Tutor_School_Request_Screen_Fault_Path", penwidth="2.6"];
  Tutor_School_Request_Screen_Get_District_Tutor_District_Details [label=<Get District (Tutor<BR/>District Details)<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Tutor District Details</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Tutor_School_Request_Screen_Get_District_Tutor_District_Details", penwidth="1.2"];
  Tutor_School_Request_Screen_Get_School_Tutor_School_Details [label=<Get School (Tutor School<BR/>Details)<BR/><FONT POINT-SIZE="8" COLOR="#555555">get Tutor School Details</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="Tutor_School_Request_Screen_Get_School_Tutor_School_Details", penwidth="1.2"];
  Tutor_School_Request_Screen_Copy_1_of_Update_Tutor_School_Details [label=<Update Tutor School<BR/>Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Tutor School Details</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="Tutor_School_Request_Screen_Copy_1_of_Update_Tutor_School_Details", penwidth="1.2"];
  Tutor_School_Request_Screen_Update_Status_on_School_by_Grade [label=<Update Status on School by<BR/>Grade<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Tutor School Details</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="Tutor_School_Request_Screen_Update_Status_on_School_by_Grade", penwidth="1.2"];
  Tutor_School_Request_Screen_Update_Tutor_School_Details [label=<Update Tutor School<BR/>Details<BR/><FONT POINT-SIZE="8" COLOR="#555555">update Tutor School Details</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="Tutor_School_Request_Screen_Update_Tutor_School_Details", penwidth="1.2"];
  start -> Tutor_School_Request_Screen_Get_School_Tutor_School_Details;
  Tutor_School_Request_Screen_School_Approval_Screen -> Tutor_School_Request_Screen_Update_Status_on_School_by_Grade [];
  Tutor_School_Request_Screen_School_Information -> Tutor_School_Request_Screen_Check_Form_Complete_Checkbox [];
  Tutor_School_Request_Screen_Check_Form_Complete_Checkbox -> Tutor_School_Request_Screen_Update_Tutor_School_Details [label="otherwise"];
  Tutor_School_Request_Screen_Check_Form_Complete_Checkbox -> Tutor_School_Request_Screen_Copy_1_of_Update_Tutor_School_Details [label="Form Complete"];
  Tutor_School_Request_Screen_Check_if_Approval_Submitted -> Tutor_School_Request_Screen_Copy_1_of_Approval_Confirmation [label="otherwise"];
  Tutor_School_Request_Screen_Check_if_Approval_Submitted -> Tutor_School_Request_Screen_School_Approval_Screen [label="Not Submitted"];
  Tutor_School_Request_Screen_Check_if_School_Schedule_Request_Complete -> Tutor_School_Request_Screen_Fault_Path [label="otherwise"];
  Tutor_School_Request_Screen_Check_if_School_Schedule_Request_Complete -> Tutor_School_Request_Screen_Check_if_Approval_Submitted [label="School Status = Scheduled"];
  Tutor_School_Request_Screen_Check_if_School_Schedule_Request_Complete -> Tutor_School_Request_Screen_Copy_1_of_Approval_Confirmation [label="School Status = School Approved"];
  Tutor_School_Request_Screen_Check_if_School_Schedule_Request_Complete -> Tutor_School_Request_Screen_School_Information [label="Form Not Complete"];
  Tutor_School_Request_Screen_Check_if_School_Schedule_Request_Complete -> Tutor_School_Request_Screen_School_Submission_Confirmation_from_saved_school_record [label="Form Complete"];
  Tutor_School_Request_Screen_Get_District_Tutor_District_Details -> Tutor_School_Request_Screen_Check_if_School_Schedule_Request_Complete [];
  Tutor_School_Request_Screen_Get_School_Tutor_School_Details -> Tutor_School_Request_Screen_Get_District_Tutor_District_Details [];
  Tutor_School_Request_Screen_Copy_1_of_Update_Tutor_School_Details -> Tutor_School_Request_Screen_School_Submission_Confirmation_from_screen_input [];
  Tutor_School_Request_Screen_Update_Status_on_School_by_Grade -> Tutor_School_Request_Screen_Approval_Confirmation [];
  Tutor_School_Request_Screen_Update_Tutor_School_Details -> Tutor_School_Request_Screen_saveReminder [];
}