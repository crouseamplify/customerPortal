digraph G {
  graph [fontname="Helvetica", rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  label=<<B>Cross-cutting mechanisms behind every page</B>>; labelloc=t; labeljust=l; fontsize=15; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];
ranksep=0.8;

    user [label=<<B>Request arrives</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">guest or authenticated portal user</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">optionally with an emailed token in the</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">URL</FONT>>, shape="box", style="rounded,filled", fillcolor="#FFFDE7", color="#F57F17", class="n-person", id="user"];
    site [label=<<B>LWR site: Amplify Customer Portal</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">route -&gt; view -&gt; theme layout</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">page access: public, or RequiresLogin</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Experience Builder audience rules</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="site"];
    pers [label=<<B>Personalisation</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">rules on Contact.Contact_Type__c and</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Account.Tier__c</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">choose nav menu (bar + mobile) and home</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">tiles</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">10 variations, first matching rule wins</FONT>>, shape="box", style="rounded,filled", fillcolor="#FFFDE7", color="#F57F17", class="n-person", id="pers"];
    track [label=<<B>Usage tracking</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">portalTracker LWC in theme layouts</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">flowPortalTracker on flow screens</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">PortalTrackingFlowStart / End actions</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">PortalTrackingController -&gt;</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Portal_Analytics__c</FONT>>, shape="box", style="rounded,filled", fillcolor="#E1F5FE", color="#0277BD", class="n-lwc", id="track"];
    flows [label=<<B>Screen flows (dxp_flow:flow)</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">embedded on pages, some with parameters</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">e.g. Input_pageName, token, recordId</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="flows"];
    ident [label=<<B>CALM Portal | Get User Details</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">resolves Contact, Account, child</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">accounts</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">and secondary Affiliations -&gt; ID lists</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">every data query is scoped by these IDs</FONT>>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", id="ident", peripheries="2"];
    fault [label=<<B>Fault Path Screen</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">21 flows route faults here</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">logs via Portal Analytics error action</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">"Something went wrong" + Try Again</FONT>>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", id="fault", peripheries="2"];
    cmdt [label=<<B>Custom metadata defaults</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">CALM Automation Defaults</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Customer Portal Automation Default</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Customer Portal Cases, PD Completion</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Default</FONT>>, shape="cylinder", style="filled", fillcolor="#E0F2F1", color="#00796B", class="n-read", id="cmdt"];
    int [label=<<B>Amplify staff (internal trigger)</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">same flows run with an internal-user</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">flag</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">resolve context from the BSO primary</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">e.g. invite contact, edit allocation on</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">behalf</FONT>>, shape="box", style="rounded,filled", fillcolor="#FFFDE7", color="#F57F17", class="n-person", id="int"];
    bg [label=<<B>Back-office automation</B><BR/><FONT POINT-SIZE="8" COLOR="#555555">record-triggered flows, platform</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">events, scheduled flows</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">user provisioning, emails, cases,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">status sync</FONT>>, shape="box", style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#9E9E9E", class="n-auto", id="bg"];
  user -> site;
  site -> pers;
  site -> track;
  site -> flows;
  flows -> ident;
  flows -> fault;
  flows -> cmdt;
  flows -> bg;
  int -> flows;
  ident -> cmdt;
  pers -> flows [style="dashed", label="tile / menu links"];
}