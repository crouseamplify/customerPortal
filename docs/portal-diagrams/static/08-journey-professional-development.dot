digraph G {
  graph [fontname="Helvetica", rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  label=<<B>Journey 5: Professional development and certificates</B>>; labelloc=t; labeljust=l; fontsize=15; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];
ranksep=0.55;

    q0 [label=<<FONT POINT-SIZE="8" COLOR="#555555">PAGE · LOGIN REQUIRED</FONT><BR/>Professional Development<BR/><FONT POINT-SIZE="8" COLOR="#555555">/professional-development</FONT>>, shape="box", style="rounded,filled", fillcolor="#FFF3E0", color="#E65100", class="n-page_login", id="q0"];
    q1 [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Request PD tab<BR/><FONT POINT-SIZE="8" COLOR="#555555">find Work Orders and Service</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Appointments</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">specific or generic request</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="q1"];
    q1a [label=<PD Request + SA / topic<BR/>connectors<BR/><FONT POINT-SIZE="8" COLOR="#555555">updates Onboarding Checklist PD</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">stage</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="q1a"];
    q1b [label=<<FONT POINT-SIZE="8" COLOR="#555555">BACK-OFFICE</FONT><BR/>PD Request automation<BR/><FONT POINT-SIZE="8" COLOR="#555555">earliest preferred dates</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">workflow-rule replacement</FONT>>, shape="box", style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#9E9E9E", class="n-auto", id="q1b"];
    q2 [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Scheduled Sessions tab<BR/><FONT POINT-SIZE="8" COLOR="#555555">select requested/scheduled SAs,</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">edit, submit change request</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="q2"];
    q3 [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Completed Sessions tab<BR/><FONT POINT-SIZE="8" COLOR="#555555">read-only table</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="q3"];
    q4 [label=<<FONT POINT-SIZE="8" COLOR="#555555">PAGE</FONT><BR/>PD Certificate of Completion<BR/><FONT POINT-SIZE="8" COLOR="#555555">/pd-certificate (no login)</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="q4"];
    q4a [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Register for CTLE Certificate<BR/><FONT POINT-SIZE="8" COLOR="#555555">session code + details, hashed</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="q4a"];
    q4b [label=<PD Completion>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="q4b"];
    q4c [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Retrieve CTLE Certificate<BR/><FONT POINT-SIZE="8" COLOR="#555555">re-enter details, hash compared</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">PDF download</FONT>>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="q4c"];
  q0 -> q1;
  q1 -> q1a;
  q1a -> q1b [style="dashed"];
  q0 -> q2 [label="later"];
  q2 -> q1a [label="change request"];
  q0 -> q3 [label="after delivery"];
  q3 -> q4 [style="dashed", label="attendees"];
  q4 -> q4a;
  q4a -> q4b;
  q4 -> q4c;
  q4c -> q4b [dir="back", label="matches"];
}