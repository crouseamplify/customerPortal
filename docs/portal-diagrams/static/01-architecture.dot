digraph G {
  graph [fontname="Helvetica", rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5, newrank=true, compound=true];
  label=<<B>How it fits together: page -&gt; screen flows -&gt; data -&gt; back-office automation</B>>; labelloc=t; labeljust=l; fontsize=15; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#607D8B", arrowsize=0.8];
ranksep=0.7; nodesep=0.25;

  people [label=<<B>Visitors and portal users</B><BR/><FONT POINT-SIZE="8">guests, contacts by type and tier,<BR/>Amplify staff (internal trigger)</FONT>>, shape=box, style="rounded,filled", fillcolor="#FFFDE7", color="#F57F17", id="people"];
  subgraph cluster_d0 { label="Sign-in and account access"; style="rounded"; color="#B0BEC5"; fontsize=12; labeljust=l;
    a0_pg_login [label=<Login<BR/><FONT POINT-SIZE="8" COLOR="#555555">/login</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="a0_pg_login"];
    a0_pg_forgotPassword [label=<Forgot Password<BR/><FONT POINT-SIZE="8" COLOR="#555555">/ForgotPassword</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="a0_pg_forgotPassword"];
    a0_fl_Customer_Portal_Request_Username [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Request Username>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="a0_fl_Customer_Portal_Request_Username"];
    a0_sub [label=<1 subflows<BR/><FONT POINT-SIZE="8" COLOR="#555555">Find Requested Username</FONT>>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="a0_sub"];
  }
  people -> a0_pg_login;
  people -> a0_pg_forgotPassword;
  a0_pg_login -> a0_fl_Customer_Portal_Request_Username;
  a0_pg_forgotPassword -> a0_fl_Customer_Portal_Request_Username;
  a0_fl_Customer_Portal_Request_Username -> a0_sub;
  subgraph cluster_d1 { label="Purchase orders"; style="rounded"; color="#B0BEC5"; fontsize=12; labeljust=l;
    a1_pg_Submit_a_PO [label=<Submit a PO<BR/><FONT POINT-SIZE="8" COLOR="#555555">/submit-a-po</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="a1_pg_Submit_a_PO"];
    a1_fl_Community_PO_Submission_Flow [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Community - PO<BR/>Submission Flow>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="a1_fl_Community_PO_Submission_Flow"];
    a1_data [label=<Data written<BR/><FONT POINT-SIZE="8" COLOR="#555555">Community Portal Log</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Task</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="a1_data"];
    a1_bg [label=<Back-office automation<BR/><FONT POINT-SIZE="8" COLOR="#555555">Community - Portal Log Send</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Confirmation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Community - Portal Log Create</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Cases</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Create Portal User From Contact</FONT>>, shape="box", style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#9E9E9E", class="n-auto", id="a1_bg"];
  }
