    a5_fl_CALM_Portal_View_Shipping_Addresses [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>View Shipping Addresses>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="a5_fl_CALM_Portal_View_Shipping_Addresses"];
    a5_fl_CALM_Portal_Blanket_Sales_Order_Show_BSO_Details [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>CALM Portal - Blanket<BR/>Sales Order - Show BSO<BR/>Details>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="a5_fl_CALM_Portal_Blanket_Sales_Order_Show_BSO_Details"];
    a5_sub [label=<6 subflows<BR/><FONT POINT-SIZE="8" COLOR="#555555">Create Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Request</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Edit Order Allocations</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Add New Shipping Addresses</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Edit Shipping Addresses</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Order Allocation Modal</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Submit an Allocation Request</FONT>>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="a5_sub"];
    a5_data [label=<Data written<BR/><FONT POINT-SIZE="8" COLOR="#555555">Blanket Sales Order (BSO)</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Order Allocation Product</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Order Allocation Request</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">(OAR)</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Order Allocation (site)</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Shipping Address</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="a5_data"];
    a5_bg [label=<Back-office automation<BR/><FONT POINT-SIZE="8" COLOR="#555555">Invite Contact to Portal Using BSO</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Status</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">BSO | Ready Allocation Email for</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Customer Portal | Invite Updated</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">BSO Primary Contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Create Portal User From Contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Send Email on Order Allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Request Submissions</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Send Submit your allocation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">reminder Email</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Create Internal Support Case</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">+4 more</FONT>>, shape="box", style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#9E9E9E", class="n-auto", id="a5_bg"];
