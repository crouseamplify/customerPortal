  a2_data -> a2_bg [style="dashed", label="triggers"];
  subgraph cluster_d3 { label="Contacts and onboarding checklist"; style="rounded"; color="#B0BEC5"; fontsize=12; labeljust=l;
    a3_pg_Contact_Management [label=<Contact Management<BR/><FONT POINT-SIZE="8" COLOR="#555555">/contact-management</FONT>>, shape="box", style="rounded,filled", fillcolor="#FFF3E0", color="#E65100", class="n-page_login", id="a3_pg_Contact_Management"];
    a3_fl_Customer_Portal_Onboarding_Checklist [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Onboarding Checklist>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="a3_fl_Customer_Portal_Onboarding_Checklist"];
    a3_fl_CALM_Portal_Contacts_Display_Contacts [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>CALM Portal - Contacts -<BR/>Display Contacts>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="a3_fl_CALM_Portal_Contacts_Display_Contacts"];
    a3_sub [label=<2 subflows<BR/><FONT POINT-SIZE="8" COLOR="#555555">New Contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Count Contact Types</FONT>>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="a3_sub"];
    a3_data [label=<Data written<BR/><FONT POINT-SIZE="8" COLOR="#555555">Affiliation</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Event: Deactivate Portal User</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Onboarding Checklist</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="a3_data"];
    a3_bg [label=<Back-office automation<BR/><FONT POINT-SIZE="8" COLOR="#555555">Create Portal User From Contact</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Customer Portal | Portal User</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Deactivation</FONT>>, shape="box", style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#9E9E9E", class="n-auto", id="a3_bg"];
