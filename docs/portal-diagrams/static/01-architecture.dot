  a1_fl_Community_PO_Submission_Flow -> a1_data;
  a1_data -> a1_bg [style="dashed", label="triggers"];
  subgraph cluster_d2 { label="Support and Help Center"; style="rounded"; color="#B0BEC5"; fontsize=12; labeljust=l;
    a2_pg_Support [label=<Support<BR/><FONT POINT-SIZE="8" COLOR="#555555">/support</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="a2_pg_Support"];
    a2_pg_Knowledge_Detail [label=<Knowledge Detail<BR/><FONT POINT-SIZE="8" COLOR="#555555">/article</FONT>>, shape="box", style="rounded,filled", fillcolor="#E8F5E9", color="#2E7D32", class="n-page_public", id="a2_pg_Knowledge_Detail"];
    a2_fl_Customer_Portal_Web_Form_to_Case [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Web Form to Case>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="a2_fl_Customer_Portal_Web_Form_to_Case"];
    a2_fl_Knowledge_Article_Feedback_Customer_Portal [label=<<FONT POINT-SIZE="8" COLOR="#555555">SCREEN FLOW</FONT><BR/>Knowledge | Article<BR/>Feedback Customer Portal>, shape="box", style="rounded,filled", fillcolor="#D1C4E9", color="#4527A0", class="n-flow", id="a2_fl_Knowledge_Article_Feedback_Customer_Portal"];
    a2_sub [label=<1 subflows<BR/><FONT POINT-SIZE="8" COLOR="#555555">Create Case from Webform</FONT>>, shape="box", style="rounded,filled", fillcolor="#EDE7F6", color="#5E35B1", class="n-subflow", peripheries="2", id="a2_sub"];
    a2_data [label=<Data written<BR/><FONT POINT-SIZE="8" COLOR="#555555">Case</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Event: Case Web Form Comment</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Article Feedback</FONT>>, shape="cylinder", style="filled", fillcolor="#C8E6C9", color="#1B5E20", class="n-write", id="a2_data"];
    a2_bg [label=<Back-office automation<BR/><FONT POINT-SIZE="8" COLOR="#555555">Send DL Emails</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Customer Portal | Web Form | Add</FONT><BR/><FONT POINT-SIZE="8" COLOR="#555555">Feed Item to Case</FONT>>, shape="box", style="rounded,filled,dashed", fillcolor="#FAFAFA", color="#9E9E9E", class="n-auto", id="a2_bg"];
  }
  people -> a2_pg_Support;
  people -> a2_pg_Knowledge_Detail;
  a2_pg_Support -> a2_fl_Customer_Portal_Web_Form_to_Case;
  a2_pg_Knowledge_Detail -> a2_fl_Knowledge_Article_Feedback_Customer_Portal;
